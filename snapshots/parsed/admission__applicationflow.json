 "bodyHtml": "\n  <!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-P994MCR\"\nheight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n<!-- End Google Tag Manager (noscript) -->\n\n<div id=\"ads-modal\" class=\"ads-modal-container\">\n  <div class=\"modal-content\">\n    <div class=\"close-button\"><img src=\"/asset/img/share/2026/button-ads-close.png\" loading=\"lazy\" alt=\"\" width=\"44\" height=\"44\"></div>\n        <a href=\"https://www.snm.ac.jp/news/2026/18962/\" class=\"banner ads-modal-banner\">\n      <img src=\"/asset/img/share/2026/banner-ads-oc01.jpg\" loading=\"lazy\" alt=\"オープンキャンパス\" width=\"295\" height=\"443\">\n    </a>\n      </div>\n</div><div class=\"contents-wrapper\">\n  <div class=\"contents-left\">\n    <div class=\"site-wrap\">\n  <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"238\" height=\"33\"></a></h1>\n  <p class=\"site-catch\"><img src=\"/asset/img/share/2025/site-catch.png\" alt=\"Future is yours\" width=\"310\" height=\"175\"></p>\n</div>      <div class=\"main-wrapper\">\n      \n    <header>\n      <input type=\"checkbox\" name=\"menu-switch\" id=\"menu-switch\" class=\"nav-checkbox\">\n      <div class=\"header\">\n        <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"420\" height=\"58\"></a></h1>\n        <div class=\"nav-block\">\n          <label for=\"menu-switch\" class=\"menu-btn\">\n            <span class=\"btn-label\">\n              <span></span><span></span><span></span>\n            </span>\n          </label>\n        </div>\n      </div>\n      <div class=\"sp-menu\">\n        <div class=\"inner\">\n          <ul class=\"sp-cv-btns\">\n            <li class=\"sp-cv-oc\">\n              <a href=\"/opencampus/\" class=\"banner\">\n                <span class=\"label\">オープン<br>キャンパス</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img01.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n                        <li class=\"sp-cv-request\">\n              <a href=\"/form/document/\" target=\"_blank\" rel=\"noopener\" class=\"no-icon banner\">\n                <span class=\"label\">資料請求</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img03.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n            <li class=\"sp-cv-special\">\n              <a href=\"/special/\" class=\"banner\">\n                <span class=\"label\">お仕事<br>紹介</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img04.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n          </ul>\n          <nav>\n            <ul class=\"sp-gnav\">\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav01\">\n                <label for=\"sp-nav01\" class=\"category-ttl\"><span class=\"en\">ABOUT</span>学校案内</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/school/\">学校案内 トップ</a></li>\n                  <li><a href=\"/school/study/\">札幌看護医療が選ばれる理由</a></li>\n                  <li><a href=\"/school/guide/\">高校1・2年生のための進路選び</a></li>\n                  <li><a href=\"/school/access/\">交通・アクセス</a></li>\n                  <li><a href=\"/school/philosophy/\">建学の理念</a></li>\n                  <li><a href=\"/school/info/\">情報公開（職業実践専門課程）</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav02\">\n                <label for=\"sp-nav02\" class=\"category-ttl\"><span class=\"en\">COURSE</span>学科・専攻</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/course/\">学科・専攻 トップ</a></li>\n                  <li><a href=\"/course/nursing/\">看護学科</a></li>\n                  <li><a href=\"/course/orthoptist/\">視能訓練士学科</a></li>\n                  <li><a href=\"/course/dentalhygienists/\">歯科衛生士学科<br>ホワイトニング・デンタルエステ専攻</a></li>\n                  <li><a href=\"/course/clinicalengineer/\">臨床工学技士学科</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav03\">\n                <label for=\"sp-nav03\" class=\"category-ttl\"><span class=\"en\">CARRER</span>資格・就職</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/career/\">資格・就職 トップ</a></li>\n                  <li><a href=\"/career/license_support/\">資格サポート</a></li>\n                  <li><a href=\"/career/job_result/\">就職サポート</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav04\">\n                <label for=\"sp-nav04\" class=\"category-ttl\"><span class=\"en\">CAMPUS LIFE</span>学校生活・施設</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/campuslife/\">学校生活・施設 トップ</a></li>\n                  <li><a href=\"/campuslife/schedule/\">キャンパスライフ</a></li>\n                  <li><a href=\"/campuslife/facility/\">施設紹介</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav05\">\n                <label for=\"sp-nav05\" class=\"category-ttl\"><span class=\"en\">ADMISSION</span>入試・学費</label>\n                <ul class=\"category-list txt-link\">\n                  <li><a href=\"/admission/\">入試・学費 トップ</a></li>\n                  <li><a href=\"/admission/application/\">募集要項・出願概要</a></li>\n                  <li><a href=\"/admission/ao/\">AO入試エントリー・AO入試出願方法</a></li>\n                  <li><a href=\"/admission/applicationflow/\">推薦・一般入試 出願方法</a></li>\n                  <li><a href=\"/admission/expenses/\">学費・奨学金制度</a></li>\n                  <li><a href=\"/admission/scholarship/\">特待生＆減免制度</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav06\">\n                <label for=\"sp-nav06\" class=\"category-ttl\"><span class=\"en\">OPEN CAMPUS</span>オープンキャンパス・説明会</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/opencampus/\">オープンキャンパスとは</a></li>\n                  <li><a href=\"/opencampus/calendar/\">イベント全日程一覧</a></li>\n                  <li><a href=\"/news/2026/17955/\">入試説明会</a></li>\n                  <li><a href=\"/opencampus/session/\">学校説明・個別相談会</a></li>\n                  <li><a href=\"/opencampus/bus/\">無料送迎バス</a></li>\n                  <li><a href=\"/opencampus/subsidy_list/\">交通費補助</a></li>\n                  <li><a href=\"/news/2026/18039/\">出張オープンキャンパス</a></li>\n                  <li><a href=\"/news/2021/5543/\">高校訪問ガイダンス</a></li>\n                </ul>\n              </li>\n                          </ul>\n          </nav>\n          <div class=\"sp-visitor-box\">\n            <input type=\"checkbox\" name=\"visitor-menu\" id=\"sp-visitor-menu\">\n            <label for=\"sp-visitor-menu\">\n              <span class=\"txt\">訪問者別メニュー</span>\n            </label>\n            <ul class=\"visitor-list\">\n              <li><a href=\"/visit_graduate/\">卒業生の方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9888/\">高等学校の先生方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9891/\">中学校の先生方へ</a></li>\n              <li><a href=\"/visit_society/\">社会人・大学生・短大生の方へ</a></li>\n              <li><a href=\"/visit_company/\">企業の方へ<span class=\"inline-block\">（求人掲載はコチラ）</span></a></li>\n              <li><a href=\"/recruit/\">職員募集につきまして</a></li>\n              <li><a href=\"/visit_municipality/\">産官学連携にご協力いただける企業・自治体の方へ</a></li>\n            </ul>\n          </div>\n          <ul class=\"sp-menu-btns\">\n            <li><a href=\"/form/inquiry/\"><span class=\"icon mail\"><img src=\"/asset/img/share/icon-mail.png\" alt=\"\" width=\"39\" height=\"28\"></span>お問い合わせ</a></li>\n            <li><a href=\"/school/access/\"><span class=\"icon access\"><img src=\"/asset/img/share/icon-access.png\" alt=\"\" width=\"28\" height=\"36\"></span>アクセス</a></li>\n          </ul>\n          <ul class=\"sp-other-btns\">\n            <li><a href=\"/school/info/\">情報公開(職業実践専門課程)</a></li>\n            <li><a href=\"/news/2024/11771/\">施設(教室)利用貸出につきまして</a></li>\n            <li><a href=\"/privacy/\">プライバシーポリシー</a></li>\n            <li><a href=\"/recruit/\">採用情報</a></li>\n            <li><a href=\"/sitemap/\">サイトマップ</a></li>\n            <li><a href=\"/socialpolicy/\">ソーシャルメディアポリシー</a></li>\n          </ul>\n        </div>\n        <div class=\"sns-link-box\">\n          <div class=\"sns-item instagram\">\n            <a href=\"https://www.instagram.com/sapporo_kango/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-instagram.png\" alt=\"\" width=\"58\" height=\"58\">\n            </a>\n          </div>\n          <div class=\"sns-item tiktok\">\n            <a href=\"https://www.tiktok.com/@sapporo_kango\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-tiktok.png\" alt=\"\" width=\"41\" height=\"48\">\n            </a>\n          </div>\n          <div class=\"sns-item youtube\">\n            <a href=\"https://www.youtube.com/channel/UCQU3cRE2T7qim5OOqXSDjww\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-youtube.png\" alt=\"\" width=\"55\" height=\"39\">\n            </a>\n          </div>\n          <div class=\"sns-item line\">\n            <a href=\"https://lin.ee/kxlpB4B\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-line.png\" alt=\"\" width=\"56\" height=\"56\">\n            </a>\n          </div>\n        </div>\n      </div>\n    </header>\n      <div class=\"main admission applicationflow\">\n        <div class=\"mv mv-block\">\n          <div class=\"wrap\">\n            <h1 class=\"page-ttl\">\n              <span class=\"text-wrap\">\n                <span class=\"eng\">ADMISSION</span>\n                <span class=\"ja\">推薦・一般入試 出願方法</span>\n              </span>\n            </h1>\n          </div>\n          <div class=\"bg-box\"><img src=\"/asset/img/admission/share/2025/mv.jpg\" alt=\"\" width=\"740\" height=\"330\"></div>\n        </div>\n                <div class=\"content-block no-lead\">\n          <div class=\"wrap\">\n            \n            <div class=\"content-box\">\n              <h2 class=\"content-ttl01\">スマホからも手続きカンタン！<br>「ネット出願」なら24時間手続き<span class=\"inline-block\">できます！</span></h2>\n              <div class=\"content-inner\">\n                <h3 class=\"content-ttl02\">ネット出願方法</h3>\n                <div class=\"button-box\"><a class=\"button yellow\" href=\"https://webappform.jikei.com/?sid=SNM\" target=\"_blank\" rel=\"noopener\">ネット出願フォーム<span class=\"arrow\"></span></a></div>\n              </div>\n              <div class=\"content-inner\">\n                <div class=\"flow-container flow-num\">\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">ネット出願をする</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <ol class=\"list-num-circle\">\n                          <li>本校HPから画面の指示に従って必要事項を入力してください。</li>\n                          <li>写真データ（正面上半身、無帽、無背景、制服または正装で3カ月以内に撮影したもの）をご準備ください。</li>\n                          <li>選考料の支払い方法を「コンビニ決済」か「クレジットカード決済」のいずれかを選択してください。</li>\n                          <li>入力完了後、登録したメールアドレスに登録完了メールが送られたら入力は完了です。</li>\n                        </ol>\n                        <ul class=\"notes\">\n                          <li>完了メールを正しく受け取るために、【info@snm.ac.jp】からのメールの受信許可をしてください。</li>\n                        </ul>\n                      \n                        <div class=\"border-box\">\n                          <h5 class=\"box-title txt-red\">記述入力内容について<span class=\"inline-block\">（志望理由など）</span></h5>\n                          <ul class=\"list-num-circle\">\n                            <li>将来の夢や目標、入学してから頑張りたいことなど、あなたの未来像[200文字以内]</li>\n                            <li>本校を志望した理由[200文字以内]</li>\n                            <li>長所・短所[100文字以内]</li>\n                            <li>趣味・特技[100文字以内]</li>\n                            <li>得意科目・不得意科目[100文字以内]</li>\n                            <li>学内外での活動歴（部活動、生徒会活動、ボランティア活動など）[200文字以内]</li>\n                            <li>資格・免許（該当する場合のみ入力）[100文字以内]</li>\n                            <li>高校卒業後の履歴・職歴（該当する場合のみ入力）[100文字以内]</li>\n                          </ul>\n                          <ul class=\"notes\">\n                            <li>入力完了後の編集はできません。</li>\n                          </ul>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box mb01\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">選考料（30,000円）のお支払い<br>（ネット出願受付期間内にお支払いください）</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>ネット出願時、 選考料のお支払い方法をお知らせします。「コンビニ決済」か「クレジットカード決済」のいずれかより選択してください。</p>\n                        <ul class=\"notes mb1\">\n                          <li>選択後の変更はできません。</li>\n                          <li>選考を辞退した場合、入学選考料の返金は致しかねますのでご了承ください。</li>\n                          <li>ネット出願期間内にお支払いください。</li>\n                        </ul>\n                        <table class=\"common-tbl admission-tbl\">\n                          <tbody>\n                            <tr>\n                              <th class=\"w50\">コンビニ決済の場合</th>\n                              <th class=\"w50\">クレジットカード決済の場合</th>\n                            </tr>\n                            <tr>\n                              <td>\n                                <p class=\"mb01\">下記のコンビニにてお取り扱いが可能です。コンビニ決済画面に従い入力し、「送信ボタン」を押すと各コンビニの振込用の番号が表示されますので、その番号を控えコンビニにてお支払いください。</p>\n                                <ul>\n                                  <li class=\"inline-block p-2 mb-2 border border-solid border-gray-300\">ファミリーマート</li>\n                                  <li class=\"inline-block p-2 mb-2 border border-solid border-gray-300\">ローソン</li>\n                                  <li class=\"inline-block p-2 mb-2 border border-solid border-gray-300\">セイコーマート</li>\n                                </ul>\n                              </td>\n                              <td class=\"align-top\">\n                                <p>画面の指示に従い入力してください。送信ボタンを押すとその場で決済されるので手続きは完了です。</p>\n                              </td>\n                            </tr>\n                          </tbody>\n                        </table>\n                      </div>\n                    </div>\n                                      </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">その他の提出書類の送付と<span class=\"inline-block\">受験票の受け取り</span></h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <ul class=\"mb01\">\n                          <li>該当する出願書類を簡易書留で郵送または窓口へ持参してください。<br>↓</li>\n                          <li>出願書類・選考料入金の確認ができ次第、本校よりメールにてWEB受験票（受験番号や入学試験、特待生試験の詳細や日時など）をお送りします。<br>↓</li>\n                          <li>WEB受験票に記載された試験日時に来校してください。</li>\n                        </ul>\n                        <ul class=\"notes\">\n                          <li>AO入試、指定校推薦の方は来校の必要はありません。</li>\n                          <li>本校から送信したメールを持参の上、来校受付時にメール本文の画面を提示してください。</li>\n                          <li>メールは無くさず保管してください。スクリーンショットは不可です。</li>\n                        </ul>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <h5 class=\"flow-item-title no-num\">入学試験の結果が届く</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>入学試験日より、2週間以内に入学試験の結果を郵送でお送りします。合格者には「学費振込依頼書」を合せてお送りします。</p>\n                        <ul class=\"notes\">\n                          <li>特待生試験を受験の方は、入学試験と特待生試験の結果を一緒にお送りします。</li>\n                        </ul>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"content-box\">\n              <div class=\"content-inner\">\n                <h3 class=\"content-ttl02\">入学までの流れ</h3>\n                <div class=\"flow-container flow-num flow02\">\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <h5 class=\"flow-item-title no-num\">入学手続き①</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p><b>1次納入手続きを行う</b><br>お送りする所定の振込用紙を使用して期日まで（合格通知発行日から2週間以内が目安）に納入を完了してください。<br><small>※原則一括納入となります。</small></p>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <h5 class=\"flow-item-title no-num\">入学許可証通知</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>1次納入手続き完了確認後、「入学許可書」をお送りします。</p>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <h5 class=\"flow-item-title no-num\">入学前登校に参加</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>入学後の授業をスムーズにスタートさせるために、本校では入学前から専門の勉強をいち早くスタートできるオリジナルのプログラム「入学前教育」として「入学前登校」や「e-learning」による学習を行っています。入学前から仲間作りや、学校生活の準備ができるため、安心して4月を迎えることができます（日程は別途お知らせします）。</p>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <h5 class=\"flow-item-title no-num\">入学手続き②<span class=\"inline-block\">（2月中旬）</span></h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p><b>2次納入手続きを行う</b><br>諸費用納入についてのご案内を2月中旬頃お送りします。所定の振込用紙を使用して3月中旬（指定の期日）までに納入を完了してください。</p>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <h5 class=\"flow-item-title no-num\">入学式案内<span class=\"inline-block\">（3月中旬）</span></h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>入学式の案内をします。入学式は4月上旬に開催を予定しております。</p>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading full\">\n                        <h5 class=\"flow-item-title no-num\">入学式（4月上旬）</h5>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"content-box\">\n              <div class=\"info-box\">\n                <h4 class=\"content-ttl03 mb01\">【指定校・高校（公募）・業界推薦希望の方】は下記より書式をダウンロードし印刷してください。</h4>\n                <p>印刷した用紙を市販の封筒に朱書きで「推薦書在中」と記載の上、簡易書留郵送にてお送りください。<br>（送付先　〒004-0051 札幌市厚別区厚別中央1条5丁目1番5号　札幌看護医療専門学校　入学事務局行）</p>\n                <ul class=\"note\">\n                  <li>オープンキャンパスなどでもお渡し可能です。</li>\n                </ul>\n                <ol>\n                  <li><a href=\"/asset/doc/admission/share/recommendation.pdf\" target=\"_blank\" rel=\"noopener\" class=\"link-txt\">推薦書</a></li>\n                </ol>\n              </div>\n            </div>\n\n            <div class=\"content-box\">\n              <ul class=\"banner-list col2\">\n                <li>\n                  <a href=\"/opencampus/\" class=\"banner\">\n                    <img src=\"/asset/img/share/2026/banner-ictoc.png\" alt=\"オープンキャンパス\" width=\"330\" height=\"310\">\n                  </a>\n                </li>\n                <li>\n                  <a href=\"/opencampus/session/\" class=\"banner\">\n                    <img src=\"/asset/img/share/2026/banner-consultation.png\" loading=\"lazy\" alt=\"学校・学科/入試/学費などじっくり相談したい方へ 学校説明＆個別相談会\" width=\"330\" height=\"310\">\n                  </a>\n                </li>\n              </ul>\n              <div class=\"banner-container\">\n                <a href=\"https://www.snm.ac.jp/news/2023/914/\" class=\"banner\"><img src=\"/asset/img/share/2026/banner-line.jpg\" width=\"700\" height=\"324\" alt=\"LINE何でも相談室 1対1トークで気軽に相談！\"></a>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div><!-- /.main -->\n      \n     <footer>\n        <div class=\"footer bg-white\">\n                    <div class=\"ft-bottom-block\">\n            <div class=\"ft-body\">\n              <div class=\"ft-body-wrap\">\n                <div class=\"ft-info-box\">\n                  <h1 class=\"ft-siteid\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"476\" height=\"80\"></a></h1>\n                  <p class=\"address\">〒004-0051<br><span class=\"inline-block\">札幌市厚別区厚別中央1条5丁目1番5号</span></p>\n                  <p class=\"tel\">TEL：011-801-8343（代表番号）<br>FAX：011-801-8345<br>フリーダイヤル：0120-37-8343</p>\n                  <p class=\"info-txt\"><a href=\"/school/info/\" class=\"link-txt\">情報公開（職業実践専門課程）</a></p>\n                </div>\n                <div class=\"ft-link-box\">\n                  <ul class=\"contact-list\">\n                    <li>\n                      <a href=\"/form/inquiry/\">\n                        <span class=\"ft-mail-icon ft-icon\"><img src=\"/asset/img/share/ft-mail-icon.png\" alt=\"\" width=\"34\" height=\"24\"></span>\n                        <span class=\"text\">お問い合わせ</span>\n                      </a>\n                    </li>\n                    <li>\n                      <a href=\"/school/access/\">\n                        <span class=\"ft-access-icon ft-icon\"><img src=\"/asset/img/share/ft-access-icon.png\" alt=\"\" width=\"24\" height=\"31\"></span>\n                        <span class=\"text\">アクセス</span>\n                      </a>\n                    </li>\n                  </ul>\n                </div>\n              </div>\n              <p class=\"pagetop\"><a href=\"#top\"><span class=\"arrow\"></span>PAGE TOP</a></p>\n            </div>\n            <div class=\"ft-visitor-box\">\n              <div class=\"visitor-accordion\">\n                <input type=\"checkbox\" id=\"ft-visitor\" class=\"ft-visitor-menu\">\n                <label for=\"ft-visitor\" class=\