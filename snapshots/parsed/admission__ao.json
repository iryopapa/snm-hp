 "bodyHtml": "\n  <!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-P994MCR\"\nheight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n<!-- End Google Tag Manager (noscript) -->\n\n<div id=\"ads-modal\" class=\"ads-modal-container\">\n  <div class=\"modal-content\">\n    <div class=\"close-button\"><img src=\"/asset/img/share/2026/button-ads-close.png\" loading=\"lazy\" alt=\"\" width=\"44\" height=\"44\"></div>\n        <a href=\"https://www.snm.ac.jp/news/2026/18962/\" class=\"banner ads-modal-banner\">\n      <img src=\"/asset/img/share/2026/banner-ads-oc01.jpg\" loading=\"lazy\" alt=\"オープンキャンパス\" width=\"295\" height=\"443\">\n    </a>\n      </div>\n</div><div class=\"contents-wrapper\">\n  <div class=\"contents-left\">\n    <div class=\"site-wrap\">\n  <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"238\" height=\"33\"></a></h1>\n  <p class=\"site-catch\"><img src=\"/asset/img/share/2025/site-catch.png\" alt=\"Future is yours\" width=\"310\" height=\"175\"></p>\n</div>      <div class=\"main-wrapper\">\n      \n    <header>\n      <input type=\"checkbox\" name=\"menu-switch\" id=\"menu-switch\" class=\"nav-checkbox\">\n      <div class=\"header\">\n        <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"420\" height=\"58\"></a></h1>\n        <div class=\"nav-block\">\n          <label for=\"menu-switch\" class=\"menu-btn\">\n            <span class=\"btn-label\">\n              <span></span><span></span><span></span>\n            </span>\n          </label>\n        </div>\n      </div>\n      <div class=\"sp-menu\">\n        <div class=\"inner\">\n          <ul class=\"sp-cv-btns\">\n            <li class=\"sp-cv-oc\">\n              <a href=\"/opencampus/\" class=\"banner\">\n                <span class=\"label\">オープン<br>キャンパス</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img01.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n                        <li class=\"sp-cv-request\">\n              <a href=\"/form/document/\" target=\"_blank\" rel=\"noopener\" class=\"no-icon banner\">\n                <span class=\"label\">資料請求</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img03.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n            <li class=\"sp-cv-special\">\n              <a href=\"/special/\" class=\"banner\">\n                <span class=\"label\">お仕事<br>紹介</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img04.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n          </ul>\n          <nav>\n            <ul class=\"sp-gnav\">\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav01\">\n                <label for=\"sp-nav01\" class=\"category-ttl\"><span class=\"en\">ABOUT</span>学校案内</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/school/\">学校案内 トップ</a></li>\n                  <li><a href=\"/school/study/\">札幌看護医療が選ばれる理由</a></li>\n                  <li><a href=\"/school/guide/\">高校1・2年生のための進路選び</a></li>\n                  <li><a href=\"/school/access/\">交通・アクセス</a></li>\n                  <li><a href=\"/school/philosophy/\">建学の理念</a></li>\n                  <li><a href=\"/school/info/\">情報公開（職業実践専門課程）</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav02\">\n                <label for=\"sp-nav02\" class=\"category-ttl\"><span class=\"en\">COURSE</span>学科・専攻</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/course/\">学科・専攻 トップ</a></li>\n                  <li><a href=\"/course/nursing/\">看護学科</a></li>\n                  <li><a href=\"/course/orthoptist/\">視能訓練士学科</a></li>\n                  <li><a href=\"/course/dentalhygienists/\">歯科衛生士学科<br>ホワイトニング・デンタルエステ専攻</a></li>\n                  <li><a href=\"/course/clinicalengineer/\">臨床工学技士学科</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav03\">\n                <label for=\"sp-nav03\" class=\"category-ttl\"><span class=\"en\">CARRER</span>資格・就職</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/career/\">資格・就職 トップ</a></li>\n                  <li><a href=\"/career/license_support/\">資格サポート</a></li>\n                  <li><a href=\"/career/job_result/\">就職サポート</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav04\">\n                <label for=\"sp-nav04\" class=\"category-ttl\"><span class=\"en\">CAMPUS LIFE</span>学校生活・施設</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/campuslife/\">学校生活・施設 トップ</a></li>\n                  <li><a href=\"/campuslife/schedule/\">キャンパスライフ</a></li>\n                  <li><a href=\"/campuslife/facility/\">施設紹介</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav05\">\n                <label for=\"sp-nav05\" class=\"category-ttl\"><span class=\"en\">ADMISSION</span>入試・学費</label>\n                <ul class=\"category-list txt-link\">\n                  <li><a href=\"/admission/\">入試・学費 トップ</a></li>\n                  <li><a href=\"/admission/application/\">募集要項・出願概要</a></li>\n                  <li><a href=\"/admission/ao/\">AO入試エントリー・AO入試出願方法</a></li>\n                  <li><a href=\"/admission/applicationflow/\">推薦・一般入試 出願方法</a></li>\n                  <li><a href=\"/admission/expenses/\">学費・奨学金制度</a></li>\n                  <li><a href=\"/admission/scholarship/\">特待生＆減免制度</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav06\">\n                <label for=\"sp-nav06\" class=\"category-ttl\"><span class=\"en\">OPEN CAMPUS</span>オープンキャンパス・説明会</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/opencampus/\">オープンキャンパスとは</a></li>\n                  <li><a href=\"/opencampus/calendar/\">イベント全日程一覧</a></li>\n                  <li><a href=\"/news/2026/17955/\">入試説明会</a></li>\n                  <li><a href=\"/opencampus/session/\">学校説明・個別相談会</a></li>\n                  <li><a href=\"/opencampus/bus/\">無料送迎バス</a></li>\n                  <li><a href=\"/opencampus/subsidy_list/\">交通費補助</a></li>\n                  <li><a href=\"/news/2026/18039/\">出張オープンキャンパス</a></li>\n                  <li><a href=\"/news/2021/5543/\">高校訪問ガイダンス</a></li>\n                </ul>\n              </li>\n                          </ul>\n          </nav>\n          <div class=\"sp-visitor-box\">\n            <input type=\"checkbox\" name=\"visitor-menu\" id=\"sp-visitor-menu\">\n            <label for=\"sp-visitor-menu\">\n              <span class=\"txt\">訪問者別メニュー</span>\n            </label>\n            <ul class=\"visitor-list\">\n              <li><a href=\"/visit_graduate/\">卒業生の方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9888/\">高等学校の先生方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9891/\">中学校の先生方へ</a></li>\n              <li><a href=\"/visit_society/\">社会人・大学生・短大生の方へ</a></li>\n              <li><a href=\"/visit_company/\">企業の方へ<span class=\"inline-block\">（求人掲載はコチラ）</span></a></li>\n              <li><a href=\"/recruit/\">職員募集につきまして</a></li>\n              <li><a href=\"/visit_municipality/\">産官学連携にご協力いただける企業・自治体の方へ</a></li>\n            </ul>\n          </div>\n          <ul class=\"sp-menu-btns\">\n            <li><a href=\"/form/inquiry/\"><span class=\"icon mail\"><img src=\"/asset/img/share/icon-mail.png\" alt=\"\" width=\"39\" height=\"28\"></span>お問い合わせ</a></li>\n            <li><a href=\"/school/access/\"><span class=\"icon access\"><img src=\"/asset/img/share/icon-access.png\" alt=\"\" width=\"28\" height=\"36\"></span>アクセス</a></li>\n          </ul>\n          <ul class=\"sp-other-btns\">\n            <li><a href=\"/school/info/\">情報公開(職業実践専門課程)</a></li>\n            <li><a href=\"/news/2024/11771/\">施設(教室)利用貸出につきまして</a></li>\n            <li><a href=\"/privacy/\">プライバシーポリシー</a></li>\n            <li><a href=\"/recruit/\">採用情報</a></li>\n            <li><a href=\"/sitemap/\">サイトマップ</a></li>\n            <li><a href=\"/socialpolicy/\">ソーシャルメディアポリシー</a></li>\n          </ul>\n        </div>\n        <div class=\"sns-link-box\">\n          <div class=\"sns-item instagram\">\n            <a href=\"https://www.instagram.com/sapporo_kango/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-instagram.png\" alt=\"\" width=\"58\" height=\"58\">\n            </a>\n          </div>\n          <div class=\"sns-item tiktok\">\n            <a href=\"https://www.tiktok.com/@sapporo_kango\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-tiktok.png\" alt=\"\" width=\"41\" height=\"48\">\n            </a>\n          </div>\n          <div class=\"sns-item youtube\">\n            <a href=\"https://www.youtube.com/channel/UCQU3cRE2T7qim5OOqXSDjww\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-youtube.png\" alt=\"\" width=\"55\" height=\"39\">\n            </a>\n          </div>\n          <div class=\"sns-item line\">\n            <a href=\"https://lin.ee/kxlpB4B\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-line.png\" alt=\"\" width=\"56\" height=\"56\">\n            </a>\n          </div>\n        </div>\n      </div>\n    </header>\n      <div class=\"main admission ao\">\n        <div class=\"mv mv-block\">\n          <div class=\"wrap\">\n            <h1 class=\"page-ttl\">\n              <span class=\"text-wrap\">\n                <span class=\"eng\">ADMISSION</span>\n                <span class=\"ja\">AO入試エントリー・<span class=\"inline-block\">AO入試出願方法</span></span>\n              </span>\n            </h1>\n          </div>\n          <div class=\"bg-box\"><img src=\"/asset/img/admission/share/2025/mv.jpg\" alt=\"\" width=\"740\" height=\"330\"></div>\n        </div>\n                <div class=\"content-block no-lead\">\n          <div class=\"wrap\">\n                      </div>\n\n          <div class=\"intro content-box\">\n            <div class=\"wrap\">\n              <div class=\"wrap-text\">\n                <h3 class=\"content-ttl02 mt0\">AO入試 <small>※看護学科を除く</small></h3>\n              </div>\n            </div>\n            <div class=\"intro-bg\">\n              <div class=\"wrap\">\n                <h4 class=\"title\">AO入試（総合型選抜）とは</h4>\n                <p class=\"txt\">AO入試（アドミッションズ・オフィス入試）は、出願者の「やる気」や「適性」と本校が求める学生像(アドミッション・ポリシー)と照らし合わせ、面談をもとに、入学を決める選考方法です。</p>\n                <div class=\"admission-policy\">\n                    <h5>アドミッション・ポリシー<small>（本校が求める学生像）</small></h5>\n                    <ol class=\"list-num\">\n                      <li>目的、目標を持ち、社会に貢献したいと考える人</li>\n                      <li>仕事観、勤労観を備えている人</li>\n                      <li>他者と共に自己の課題を発見し、解決する意欲がある人</li>\n                    </ol>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"merit content-box\">\n            <div class=\"wrap\">\n              <h3 class=\"content-ttl02\">AO入試（総合型選抜）のメリット</h3>\n              <div class=\"column-container merit\">\n                <div class=\"column-item\">\n                  <div class=\"column-title\">\n                    <span class=\"merit-num\"><span class=\"img\"><img src=\"/asset/img/share/2025/merit-img.png\" alt=\"MERIT\" width=\"47\" height=\"16\"></span></span>\n                    <p class=\"lead-text\">早く進路を<br>決められるから安心！</p>\n                  </div>\n                  <div class=\"column-body text\">2026年6月1日（月）より、AOエントリー受付がスタート。早期に進路を決めることが可能です。</div>\n                </div>\n                <div class=\"column-item\">\n                  <div class=\"column-title\">\n                    <span class=\"merit-num\"><span class=\"img\"><img src=\"/asset/img/share/2025/merit-img.png\" alt=\"MERIT\" width=\"47\" height=\"16\"></span></span>\n                    <p class=\"lead-text\">選考は人物重視！<br>筆記試験はありません。</p>\n                  </div>\n                  <div class=\"column-body text\">あなたの「やる気」と「適性」を重視！人物重視の入試方法です。</div>\n                </div>\n                              </div>\n            </div>\n          </div>\n\n          <div class=\"content-box\">\n            <div class=\"wrap\">\n              <div id=\"a-03\">\n                <div class=\"wrap-text\">\n                  <h3 class=\"content-ttl02\">AO審査（面談）・AO入試選考日</h3>\n                  <h4 class=\"content-ttl03\">AO審査日（面談日）</h4>\n                                  </div>\n                <div class=\"content-inner\">\n                  <div class=\"scroll-tbl\" data-simplebar=\"\" data-simplebar-auto-hide=\"false\">\n                    <table class=\"common-tbl admission-tbl txt-center\">\n                      <thead>\n                        <tr>\n                          <th></th>\n                          <th colspan=\"7\" class=\"txt-center\">第1期</th>\n                          <th colspan=\"2\" class=\"txt-center\">第2期</th>\n                          <th class=\"txt-center\">第3期</th>\n                          <th colspan=\"2\" class=\"txt-center\">第4期</th>\n                          <th colspan=\"2\" class=\"txt-center\">第5期</th>\n                        </tr>\n                      </thead>\n                      <tbody>\n                        <tr>\n                          <th class=\"w10\">AO審査日<span class=\"inline-block\">（面談日）</span></th>\n                          <td>6/6（土）</td>\n                          <td>6/13（土）</td>\n                          <td>6/20（土）</td>\n                          <td>7/12（日）</td>\n                          <td>7/19（日）</td>\n                          <td>8/2（日）</td>\n                          <td>8/22（土）</td>\n                          <td>9/12（土）</td>\n                          <td>9/26（土）</td>\n                          <td>10/10（土）</td>\n                          <td>11/3（火・祝）</td>\n                          <td>11/28（土）</td>\n                          <td>12/5（土）</td>\n                          <td>12/13（日）</td>\n                        </tr>\n                        <tr>\n                          <th>AO<span class=\"inline-block\">エントリー</span><span class=\"inline-block\">受付期間</span></th>\n                          <td>6/1（月）～6/4（木）</td>\n                          <td>6/1（月）～6/11（木）</td>\n                          <td>6/1（月）～6/18（木）</td>\n                          <td>6/1（月）～7/9（木）</td>\n                          <td>6/1（月）～7/16（木）</td>\n                          <td>7/20（月・祝）～7/30（木）</td>\n                          <td>8/3（月）～8/20（木）</td>\n                          <td>8/21（金）～9/10（木）</td>\n                          <td>9/11（金）～9/24（木）</td>\n                          <td>9/25（金）～10/8（木）</td>\n                          <td>10/9（金）～10/29（木）</td>\n                          <td>10/30（金）～11/26（木）</td>\n                          <td>11/27（金）～12/3（木）</td>\n                          <td>12/4（金）～12/10（木）</td>\n                        </tr>\n                      </tbody>\n                    </table>\n                  </div>\n                </div>\n                <div class=\"content-inner\">\n                  <ul class=\"notes\">\n                    <li>AO入試エントリー承諾書の確認ができ次第、AO審査（面談）時間をメールまたはLINEでお知らせします。</li>\n                    <li>遠方の方はオンライン（ZOOM）面談も可能です。</li>\n                  </ul>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"content-box\">\n            <div class=\"wrap\">\n                            <p class=\"sub-title\"><span class=\"inner\">よくある質問まとめました！<br>エントリー前に確認しておこう</span></p>\n              <ul class=\"banner-list col2\" style=\"margin-top: 0;\">\n                <li>\n                  <a href=\"https://www.snm.ac.jp/news/2025/14409/\" class=\"banner\">\n                    <img src=\"/asset/img/share/2026/banner-aoentry.png\" width=\"330\" height=\"310\" alt=\"AO入試＆＆エントリー徹底解説！\">\n                  </a>\n                </li>\n                <li>\n                  <a href=\"https://www.snm.ac.jp/news/2026/17955/\" class=\"banner\">\n                    <img src=\"/asset/img/share/2026/banner-examination.png\" width=\"330\" height=\"310\" alt=\"入試説明会\">\n                  </a>\n                </li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"content-box\">\n            <div class=\"wrap\">\n              <div class=\"num-box\">\n                <h3 class=\"content-ttl02\">AO入試の流れ</h3>\n                <div class=\"flow-container flow-num\">\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">オープンキャンパス（出張・オンライン含む）・入試説明会・学校説明会のいずれかに1回以上参加する</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                                                <ul class=\"oc-list\">\n                          <li>\n                            <a href=\"/opencampus/\" class=\"banner\">\n                              <div class=\"ph-box\"><img src=\"/asset/img/share/2026/banner-ictoc.png\" alt=\"\" width=\"260\" height=\"170\"></div>\n                            </a>\n                          </li>\n                          <li>\n                            <a href=\"/opencampus/session/\" class=\"banner\">\n                              <div class=\"ph-box\"><img src=\"/asset/img/share/2026/banner-consultation.png\" alt=\"\" width=\"260\" height=\"170\"></div>\n                            </a>\n                          </li>\n                                                                            </ul>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">ネットAOエントリーする</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>2026年6月1日（月）より、ネットAOエントリー受付スタート！</p>\n                        <p>お手持ちのスマートフォン・PCで24時間手続きが可能です。</p>\n                        <ul class=\"notes mb01\"><li>ネットエントリー番号は控えておいてください</li></ul>\n                        <div class=\"txt-center mb01\"><a href=\"https://webappform.jikei.com/entry/?sid=snm\" target=\"_blank\" rel=\"noopener\" class=\"button yellow\">ネットAOエントリー<span class=\"inline-block\">フォーム</span><span class=\"arrow\"></span></a></div>\n                        <ul class=\"list-num-circle\">\n                          <li>将来の夢や目標、入学してから頑張りたいことなど、あなたの未来像[200文字以内]</li>\n                          <li>本校を志望した理由[200文字以内]</li>\n                          <li>長所・短所[100文字以内]</li>\n                          <li>趣味・特技[100文字以内]</li>\n                          <li>得意科目・不得意科目[100文字以内]</li>\n                          <li>学内外での活動歴（部活動、生徒会活動、ボランティア活動など）[200文字以内]</li>\n                          <li>資格・免許（該当する場合のみ入力）[100文字以内]</li>\n                          <li>高校卒業後の履歴・職歴（該当する場合のみ入力）[100文字以内]</li>\n                        </ul>\n                        <!-- <div class=\"movie-box\">\n                          <div class=\"mov-thumbnail\">\n                            <a href=\"https://youtu.be/GjSrKQYLevw&amp;mute=1\" data-lity>\n                              <img src=\"/asset/img/admission/ao/mov-thumbnail01.jpg\" alt=\"AOエントリー方法動画解説\" width=\"496\" height=\"278\">\n                            </a>\n                          </div>\n                        </div> -->\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">エントリー承諾書をアップロード</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>入力後のAOエントリー シートを印刷し、高校の先生から署 名をもらいます。先生の署名入りのAOエントリ ー シ ートを撮影し、その画像をアップロ ー ドしてください。</p>\n                        <ul class=\"notes\">\n                          <li><b>AOエントリー受付期間内にアップロードまで完了させてください</b></li>\n                          <li><b>高校の先生の署名がない場合は面談を実施できません</b></li>\n                        </ul>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">AO審査（面談）を受ける</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>AOエントリー受付後</p>\n                        <ul class=\"list-disc\">\n                          <li>エントリー承諾書の確認ができ次第、AO審査（面談）時間をメールまたはLINEでお知らせします。</li>\n                          <li>遠方の方は、オンライン(ZOOM)面談も可能です。</li>\n                        </ul>\n                        <ul class=\"notes\">\n                          <li>AOエントリ一時に選択できます。</li>\n                        </ul>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">AO入試出願許可証が届く</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>面談後、10日以内にAO審査（面談）結果をお送りします。 出願許可を得た方は、出願書類を準備してネット出願受付期間内に出願・提出をしてください。</p>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\" id=\"step5\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">ネット出願をする</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <ol class=\"list-num-circle\">\n                          <li>本校HPから画面の指示に従って必要事項を入力してください。</li>\n                          <li>写真データ（正面上半身、無帽、無背景、制服または正装で3カ月以内に撮影したもの）をご準備ください。</li>\n                          <li>選考料の支払い方法を「コンビニ決済」か「クレジットカード決済」のいずれかを選択してください。</li>\n                          <li>入力完了後、登録したメールアドレスに登録完了メールが送られたら入力は完了です。</li>\n                        </ol>\n                        <ul class=\"notes mb01\">\n                          <li>完了メールを正しく受け取るために、【info@snm.ac.jp】からのメールの受信許可をしてください。</li>\n                        </ul>\n                                                                        <div class=\"txt-center mb01\"><a href=\"https://webappform.jikei.com/?sid=SNM\" target=\"_blank\" rel=\"noopener\" class=\"button yellow\">ネット出願<span class=\"inline-block\">フォーム</span><span class=\"arrow\"></span></a></div>\n                                                <div class=\"border-box\">\n                          <h5 class=\"box-title txt-red\">記述入力内容について<span class=\"inline-block\">（志望理由など）</span></h5>\n                          <ul class=\"list-num-circle\">\n                            <li>将来の夢や目標、入学してから頑張りたいことなど、あなたの未来像[200文字以内]</li>\n                            <li>本校を志望した理由[200文字以内]</li>\n                            <li>長所・短所[100文字以内]</li>\n                            <li>趣味・特技[100文字以内]</li>\n                            <li>得意科目・不得意科目[100文字以内]</li>\n                            <li>学内外での活動歴（部活動、生徒会活動、ボランティア活動など）[200文字以内]</li>\n                            <li>資格・免許（該当する場合のみ入力）[100文字以内]</li>\n                            <li>高校卒業後の履歴・職歴（該当する場合のみ入力）[100文字以内]</li>\n                          </ul>\n                          <ul class=\"notes\">\n                            <li>入力完了後の編集はできません。</li>\n                          </ul>\n                        </div>\n                                              </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">選考料（30,000円）の<span class=\"inline-block\">お支払い</span><br><small>（ネット出願受付期間内にお支払いください）</small></h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>ネット出願時、 選考料のお支払い方法をお知らせします。「コンビニ決済」か「クレジットカード決済」のいずれかより選択してください。</p>\n                        <ul class=\"notes\">\n                          <li>選択後の変更はできません。</li>\n                          <li>選考を辞退した場合、入学選考料の返金は致しかねますのでご了承ください。</li>\n                          <li>ネット出願受付期間内にお支払いください。</li>\n                        </ul>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">合格通知・<span class=\"inline-block\">学費振込依頼書</span></h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>入学選考日から2週間以内に本人に郵送でお送りいたします。<br>合格者には、合格通知、学費（入学金、授業料、実習費、施設設備費）振込依頼書をお送りいたします。</p>\n                        <ul class=\"notes\"><li>特待生試験を受験の方は入学選考と特待生試験の結果を一緒にお送りします。</li></ul>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"flow-item\">\n                    <div class=\"box\">\n                      <div class=\"flow-item-heading\">\n                        <div class=\"num-title\">STEP</div>\n                        <h5 class=\"flow-item-title\">入学前登校に参加</h5>\n                      </div>\n                      <div class=\"flow-item-body\">\n                        <p>入学後の授業をスムーズにスタートさせるために、本校では入学前から専門の勉強をいち早くスタートできるオリジナルのプログラム「入学前教育」として「入学前登校」や「e-learning」による学習を行っています。入学前から仲間作りや、学校生活の準備ができるため、安心して4月を迎えることができます（日程は別途お知らせします）。</p>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"content-box\">\n            <div class=\"wrap\">\n              <h3 class=\"content-ttl02\">AO入試よくある質問</h3>\n              <div class=\"qa-item\">\n                <p class=\"q-txt\"><span class=\"number en\">Q.</span>AOエントリーシートが印刷できない！</p>\n                <p class=\"a-txt\"><span class=\"number en\">A.</span>携帯の「ファイル」の中を確認して、印刷しよう！</p>\n              </div>\n              <div class=\"qa-item\">\n                <p class=\"q-txt\"><span class=\"number en\">Q.</span>写真や承諾書をアップロードできない！</p>\n                <p class=\"a-txt\"><span class=\"number en\">A.</span>SafariやChromeなどブラウザを変更して試してみてくださいね。</p>\n              </div>\n              <div class=\"qa-item\">\n                <p class=\"q-txt\"><span class=\"number en\">Q.</span>入力完了後の修正はできるの？</p>\n                <p class=\"a-txt\"><span class=\"number en\">A.</span>入力完了後は修正できませんので、入力項目をしっかり確認してから完了をしよう！</p>\n              </div>\n              <div class=\"qa-item\">\n                <p class=\"q-txt\"><span class=\"number en\">Q.</span>メールが届かない！</p>\n                <p class=\"a-txt\"><span class=\"number en\">A.</span>メールアドレスが正しいか、メール受信許可がOKになっているか、ごみ箱や迷惑メールのフォルダに入っていないか確認しよう！</p>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"content-box\">\n            <div class=\"banner-section wrap\">\n              <div class=\"banner-container\">\n                <a href=\"https://www.snm.ac.jp/news/2023/914/\" class=\"banner\"><img src=\"/asset/img/share/2026/banner-line.jpg\" width=\"700\" height=\"324\" alt=\"LINE何でも相談室 1対1トークで気軽に相談！\"></a>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div><!-- /.main -->\n      \n     <footer>\n        <div class=\"footer bg-white\">\n                    <div class=\"ft-bottom-block\">\n            <div class=\"ft-body\">\n              <div class=\"ft-body-wrap\">\n                <div class=\"ft-info-box\">\n                  <h1 class=\"ft-siteid\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"476\" height=\"80\"></a></h1>\n                  <p class=\"address\">〒004-0051<br><span class=\"inline-block\">札幌市厚別区厚別中央1条5丁目1番5号</span></p>\n                  <p class=\"tel\">TEL：011-801-8343（代表番号）<br>FAX：011-801-8345<br>フリーダイヤル：0120-37-8343</p>\n                  <p class=\"info-txt\"><a href=\"/school/info/\" class=\"link-txt\">情報公開（職業実践専門課程）</a></p>\n                </div>\n                <div class=\"ft-link-box\">\n                  <ul class=\"contact-list\">\n                    <li>\n                      <a href=\"/form/inquiry/\">\n                        <span class=\"ft-mail-icon ft-icon\"><img src=\"/asset/img/share/ft-mail-icon