 "bodyHtml": "\n  <!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-P994MCR\"\nheight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n<!-- End Google Tag Manager (noscript) -->\n\n<div id=\"ads-modal\" class=\"ads-modal-container\">\n  <div class=\"modal-content\">\n    <div class=\"close-button\"><img src=\"/asset/img/share/2026/button-ads-close.png\" loading=\"lazy\" alt=\"\" width=\"44\" height=\"44\"></div>\n        <a href=\"https://www.snm.ac.jp/news/2026/18962/\" class=\"banner ads-modal-banner\">\n      <img src=\"/asset/img/share/2026/banner-ads-oc01.jpg\" loading=\"lazy\" alt=\"オープンキャンパス\" width=\"295\" height=\"443\">\n    </a>\n      </div>\n</div><div class=\"contents-wrapper\">\n  <div class=\"contents-left\">\n    <div class=\"site-wrap\">\n  <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"238\" height=\"33\"></a></h1>\n  <p class=\"site-catch\"><img src=\"/asset/img/share/2025/site-catch.png\" alt=\"Future is yours\" width=\"310\" height=\"175\"></p>\n</div>      <div class=\"main-wrapper\">\n      \n    <header>\n      <input type=\"checkbox\" name=\"menu-switch\" id=\"menu-switch\" class=\"nav-checkbox\">\n      <div class=\"header\">\n        <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"420\" height=\"58\"></a></h1>\n        <div class=\"nav-block\">\n          <label for=\"menu-switch\" class=\"menu-btn\">\n            <span class=\"btn-label\">\n              <span></span><span></span><span></span>\n            </span>\n          </label>\n        </div>\n      </div>\n      <div class=\"sp-menu\">\n        <div class=\"inner\">\n          <ul class=\"sp-cv-btns\">\n            <li class=\"sp-cv-oc\">\n              <a href=\"/opencampus/\" class=\"banner\">\n                <span class=\"label\">オープン<br>キャンパス</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img01.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n                        <li class=\"sp-cv-request\">\n              <a href=\"/form/document/\" target=\"_blank\" rel=\"noopener\" class=\"no-icon banner\">\n                <span class=\"label\">資料請求</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img03.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n            <li class=\"sp-cv-special\">\n              <a href=\"/special/\" class=\"banner\">\n                <span class=\"label\">お仕事<br>紹介</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img04.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n          </ul>\n          <nav>\n            <ul class=\"sp-gnav\">\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav01\">\n                <label for=\"sp-nav01\" class=\"category-ttl\"><span class=\"en\">ABOUT</span>学校案内</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/school/\">学校案内 トップ</a></li>\n                  <li><a href=\"/school/study/\">札幌看護医療が選ばれる理由</a></li>\n                  <li><a href=\"/school/guide/\">高校1・2年生のための進路選び</a></li>\n                  <li><a href=\"/school/access/\">交通・アクセス</a></li>\n                  <li><a href=\"/school/philosophy/\">建学の理念</a></li>\n                  <li><a href=\"/school/info/\">情報公開（職業実践専門課程）</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav02\">\n                <label for=\"sp-nav02\" class=\"category-ttl\"><span class=\"en\">COURSE</span>学科・専攻</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/course/\">学科・専攻 トップ</a></li>\n                  <li><a href=\"/course/nursing/\">看護学科</a></li>\n                  <li><a href=\"/course/orthoptist/\">視能訓練士学科</a></li>\n                  <li><a href=\"/course/dentalhygienists/\">歯科衛生士学科<br>ホワイトニング・デンタルエステ専攻</a></li>\n                  <li><a href=\"/course/clinicalengineer/\">臨床工学技士学科</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav03\">\n                <label for=\"sp-nav03\" class=\"category-ttl\"><span class=\"en\">CARRER</span>資格・就職</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/career/\">資格・就職 トップ</a></li>\n                  <li><a href=\"/career/license_support/\">資格サポート</a></li>\n                  <li><a href=\"/career/job_result/\">就職サポート</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav04\">\n                <label for=\"sp-nav04\" class=\"category-ttl\"><span class=\"en\">CAMPUS LIFE</span>学校生活・施設</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/campuslife/\">学校生活・施設 トップ</a></li>\n                  <li><a href=\"/campuslife/schedule/\">キャンパスライフ</a></li>\n                  <li><a href=\"/campuslife/facility/\">施設紹介</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav05\">\n                <label for=\"sp-nav05\" class=\"category-ttl\"><span class=\"en\">ADMISSION</span>入試・学費</label>\n                <ul class=\"category-list txt-link\">\n                  <li><a href=\"/admission/\">入試・学費 トップ</a></li>\n                  <li><a href=\"/admission/application/\">募集要項・出願概要</a></li>\n                  <li><a href=\"/admission/ao/\">AO入試エントリー・AO入試出願方法</a></li>\n                  <li><a href=\"/admission/applicationflow/\">推薦・一般入試 出願方法</a></li>\n                  <li><a href=\"/admission/expenses/\">学費・奨学金制度</a></li>\n                  <li><a href=\"/admission/scholarship/\">特待生＆減免制度</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav06\">\n                <label for=\"sp-nav06\" class=\"category-ttl\"><span class=\"en\">OPEN CAMPUS</span>オープンキャンパス・説明会</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/opencampus/\">オープンキャンパスとは</a></li>\n                  <li><a href=\"/opencampus/calendar/\">イベント全日程一覧</a></li>\n                  <li><a href=\"/news/2026/17955/\">入試説明会</a></li>\n                  <li><a href=\"/opencampus/session/\">学校説明・個別相談会</a></li>\n                  <li><a href=\"/opencampus/bus/\">無料送迎バス</a></li>\n                  <li><a href=\"/opencampus/subsidy_list/\">交通費補助</a></li>\n                  <li><a href=\"/news/2026/18039/\">出張オープンキャンパス</a></li>\n                  <li><a href=\"/news/2021/5543/\">高校訪問ガイダンス</a></li>\n                </ul>\n              </li>\n                          </ul>\n          </nav>\n          <div class=\"sp-visitor-box\">\n            <input type=\"checkbox\" name=\"visitor-menu\" id=\"sp-visitor-menu\">\n            <label for=\"sp-visitor-menu\">\n              <span class=\"txt\">訪問者別メニュー</span>\n            </label>\n            <ul class=\"visitor-list\">\n              <li><a href=\"/visit_graduate/\">卒業生の方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9888/\">高等学校の先生方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9891/\">中学校の先生方へ</a></li>\n              <li><a href=\"/visit_society/\">社会人・大学生・短大生の方へ</a></li>\n              <li><a href=\"/visit_company/\">企業の方へ<span class=\"inline-block\">（求人掲載はコチラ）</span></a></li>\n              <li><a href=\"/recruit/\">職員募集につきまして</a></li>\n              <li><a href=\"/visit_municipality/\">産官学連携にご協力いただける企業・自治体の方へ</a></li>\n            </ul>\n          </div>\n          <ul class=\"sp-menu-btns\">\n            <li><a href=\"/form/inquiry/\"><span class=\"icon mail\"><img src=\"/asset/img/share/icon-mail.png\" alt=\"\" width=\"39\" height=\"28\"></span>お問い合わせ</a></li>\n            <li><a href=\"/school/access/\"><span class=\"icon access\"><img src=\"/asset/img/share/icon-access.png\" alt=\"\" width=\"28\" height=\"36\"></span>アクセス</a></li>\n          </ul>\n          <ul class=\"sp-other-btns\">\n            <li><a href=\"/school/info/\">情報公開(職業実践専門課程)</a></li>\n            <li><a href=\"/news/2024/11771/\">施設(教室)利用貸出につきまして</a></li>\n            <li><a href=\"/privacy/\">プライバシーポリシー</a></li>\n            <li><a href=\"/recruit/\">採用情報</a></li>\n            <li><a href=\"/sitemap/\">サイトマップ</a></li>\n            <li><a href=\"/socialpolicy/\">ソーシャルメディアポリシー</a></li>\n          </ul>\n        </div>\n        <div class=\"sns-link-box\">\n          <div class=\"sns-item instagram\">\n            <a href=\"https://www.instagram.com/sapporo_kango/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-instagram.png\" alt=\"\" width=\"58\" height=\"58\">\n            </a>\n          </div>\n          <div class=\"sns-item tiktok\">\n            <a href=\"https://www.tiktok.com/@sapporo_kango\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-tiktok.png\" alt=\"\" width=\"41\" height=\"48\">\n            </a>\n          </div>\n          <div class=\"sns-item youtube\">\n            <a href=\"https://www.youtube.com/channel/UCQU3cRE2T7qim5OOqXSDjww\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-youtube.png\" alt=\"\" width=\"55\" height=\"39\">\n            </a>\n          </div>\n          <div class=\"sns-item line\">\n            <a href=\"https://lin.ee/kxlpB4B\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-line.png\" alt=\"\" width=\"56\" height=\"56\">\n            </a>\n          </div>\n        </div>\n      </div>\n    </header>\n      <div class=\"main campuslife facility\">\n        <div class=\"mv bg-white\">\n          <div class=\"mv-wrap\">\n            <div class=\"mv-inner\">\n              <div class=\"mv-img\"><img src=\"/asset/img/campuslife/facility/mv-img.jpg\" alt=\"\" width=\"780\" height=\"750\"></div>\n            </div>\n            <h2 class=\"mv-title\"><span class=\"title\">施設紹介</span></h2>\n            <p class=\"mv-catch\"><img src=\"/asset/img/campuslife/facility/mv-catch.png\" alt=\"Facility introduction\" width=\"271\" height=\"57\"></p>\n          </div>\n        </div>\n        <div class=\"facility-block block01\">\n          <div class=\"title-box\">\n            <div class=\"wrap\">\n              <h3 class=\"facility-title\">\n                <span class=\"color-grad\">最新<span class=\"small\">の</span>快適<span class=\"small\">な</span>校舎<span class=\"small\">と</span></span><br>\n                <span class=\"color-grad\">充実<span class=\"small\">した</span>設備<span class=\"small\">で</span></span>\n              </h3>\n              <p class=\"facility-catch anim fadeInUp\"><img src=\"/asset/img/campuslife/facility/2025/head-catch.png\" alt=\"Enjoy a fun campus life!\" width=\"594\" height=\"192\"></p>\n            </div>\n          </div>\n          <ul class=\"facility-img\">\n            <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/head-list01.jpg\" alt=\"\" width=\"380\" height=\"253\"></li>\n            <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/head-list02.jpg\" alt=\"\" width=\"364\" height=\"460\"></li>\n            <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/head-list03.jpg\" alt=\"\" width=\"240\" height=\"240\"></li>\n          </ul>\n          <div class=\"facility-group group01\">\n            <div class=\"facility-head\">\n              <div class=\"head-wrap\">\n                <div class=\"head-img anim fadeIn\"><img src=\"/asset/img/campuslife/facility/facility01-img01.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n              </div>\n              <div class=\"head-txt\">\n                <div class=\"wrap\">\n                  <h4 class=\"group-title\"><span class=\"marker\">まちとつながる<span class=\"fuchidori\">プロムナードキャンパス</span></span></h4>\n                  <p>新たな街づくりにより、「アカデミック街区」として創設された札幌看護医療専門学校。同敷地内には札幌学院大学もあり、共に学べる環境が整っています。屋外プロムナードを通って、毎日明るい気持ちで登校できるお洒落な校舎です。</p>\n                </div>\n              </div>\n            </div>\n            <div class=\"facility-body\">\n              <div class=\"body-img anim fadeIn\"><img src=\"/asset/img/campuslife/facility/facility01-img02.jpg\" alt=\"\" width=\"640\" height=\"426\"></div>\n              <div class=\"body-txt\">\n                <p>外観はプロムナードの舗装と連続感をもたせ、水平性を強調したアースカラー「大地」の外装。</p>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"facility-group group02\">\n            <div class=\"facility-head\">\n              <div class=\"head-img\"><img src=\"/asset/img/campuslife/facility/facility02-img01.jpg\" alt=\"\" width=\"780\" height=\"520\"></div>\n              <div class=\"head-txt\">\n                <div class=\"wrap\">\n                  <h4 class=\"group-title\">\n                    <span class=\"marker\">出会いと居場所が見つかる</span>\n                    <span class=\"marker\">開放的な<span class=\"fuchidori\">エントランスホール</span></span>\n                  </h4>\n                  <p>1～2階には屋内外のつながりを促すフォリーが<ruby>鏤<rt>ちりば</rt></ruby>められたガーデン・ホール空間を配置しました。</p>\n                </div>\n              </div>\n            </div>\n            <div class=\"facility-body\">\n              <ul class=\"body-list\">\n                <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/facility02-img02.jpg\" alt=\"\" width=\"600\" height=\"400\"></li>\n                <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/facility02-img03.jpg\" alt=\"\" width=\"290\" height=\"290\"></li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"facility-group group03\">\n            <div class=\"facility-head\">\n              <div class=\"head-img\"><img src=\"/asset/img/campuslife/facility/facility03-img01.jpg\" alt=\"\" width=\"780\" height=\"520\"></div>\n              <div class=\"head-txt\">\n                <div class=\"wrap\">\n                  <h4 class=\"group-title\"><span class=\"marker\">自然光が心地いい<span class=\"fuchidori\">キャンパスカフェ</span></span></h4>\n                  <p>1日の自然光のリズムに合わせた「サーカディアン照明」を導入することで、時間によって移り変わる空間を実現しました。</p>\n                </div>\n              </div>\n            </div>\n            <div class=\"facility-body\">\n              <ul class=\"body-list\">\n                <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/facility03-img02.jpg\" alt=\"\" width=\"510\" height=\"340\"></li>\n                <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/facility03-img03.jpg\" alt=\"\" width=\"248\" height=\"248\"></li>\n                <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/facility03-img04.jpg\" alt=\"\" width=\"600\" height=\"400\"></li>\n              </ul>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"theme-block\">\n          <div class=\"wrap\">\n            <h3 class=\"theme-title\"><span class=\"yellow fuchidori\">「共感の大地」</span></h3>\n            <p class=\"lead\">「共感の大地」をテーマに、<br>教室と実習室を一体化させる共用廊下空間にて<br>学科ごと／フロアごとの共感を重視した空間とし、<br>多様な教育の場が散策できます。</p>\n          </div>\n          <div class=\"block-bg\"><img src=\"/asset/img/campuslife/facility/2025/theme-bg.jpg\" alt=\"\" width=\"780\" height=\"1500\"></div>\n        </div>\n\n        <div class=\"facility-block block02\">\n          <div class=\"facility-group group04\">\n            <div class=\"facility-head\">\n              <div class=\"head-img\"><img src=\"/asset/img/campuslife/facility/facility04-img01.jpg\" alt=\"\" width=\"780\" height=\"520\"></div>\n              <div class=\"head-txt\">\n                <div class=\"wrap\">\n                  <h4 class=\"group-title\"><span class=\"marker\">明るく広々とした<span class=\"fuchidori\">図書館</span></span></h4>\n                  <p>必要な専門図書を取り揃え、仕切りで区切られたスペースもあり、一人ひとりが集中できる区間です。</p>\n                </div>\n              </div>\n            </div>\n            <div class=\"facility-body\">\n              <ul class=\"body-list\">\n                <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/2026/facility04-img02.jpg\" alt=\"\" width=\"290\" height=\"290\"></li>\n                <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/facility04-img03.jpg\" alt=\"\" width=\"600\" height=\"400\"></li>\n              </ul>\n            </div>\n          </div>\n\n          <div class=\"facility-group group05\">\n            <div class=\"facility-head\">\n              <div class=\"head-img\"><img src=\"/asset/img/campuslife/facility/facility05-img01.jpg\" alt=\"\" width=\"780\" height=\"520\"></div>\n              <div class=\"head-txt\">\n                <div class=\"wrap\">\n                  <h4 class=\"group-title\">\n                    <span class=\"marker\">モダンで開放的な設計の</span><br>\n                    <span class=\"marker\"><span class=\"fuchidori\">カンファレンスシアター</span></span>\n                  </h4>\n                  <p>最大200名を収容できるホールシアターでは、学内だけでなく地域イベントやセミナー開催など幅広く活用されています。</p>\n                </div>\n              </div>\n            </div>\n            <div class=\"facility-body\">\n              <ul class=\"body-list\">\n                <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/facility05-img02.jpg\" alt=\"\" width=\"600\" height=\"400\"></li>\n              </ul>\n              <p class=\"img-catch anim fadeInUp\"><img src=\"/asset/img/campuslife/facility/facility05-img02-txt.png\" alt=\"\" width=\"345\" height=\"105\"></p>\n            </div>\n          </div>\n\n          <div class=\"facility-group group06\">\n            <div class=\"facility-head\">\n              <div class=\"head-img\"><img src=\"/asset/img/campuslife/facility/facility06-img01.jpg\" alt=\"\" width=\"780\" height=\"520\"></div>\n              <div class=\"head-txt\">\n                <div class=\"wrap\">\n                  <h4 class=\"group-title\"><span class=\"marker\">キレイで清潔感のある<span class=\"fuchidori\">パウダールーム</span></span></h4>\n                  <p>実習後や授業の合間に気兼ねなく身だしなみチェックやメイク直しが できるパウダールームです。</p>\n                </div>\n              </div>\n            </div>\n            <div class=\"facility-body\">\n              <ul class=\"body-list\">\n                <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/2026/facility06-img03.jpg\" alt=\"\" width=\"290\" height=\"290\"></li>\n                <li class=\"anim fadeIn\"><img src=\"/asset/img/campuslife/facility/facility06-img02.jpg\" alt=\"\" width=\"510\" height=\"340\"></li>\n              </ul>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"pickup-block bg-white\">\n          <div class=\"wrap\">\n            <div class=\"icon\"><img src=\"/asset/img/campuslife/facility/pickup-icon.png\" alt=\"Pick up\" width=\"144\" height=\"144\"></div>\n            <div class=\"pickup-inner\">\n              <div class=\"pickup-group group01\">\n                <h4 class=\"pickup-title\">\n                  <span class=\"title-icon anim fadeInUp\"><img src=\"/asset/img/campuslife/facility/2025/title-icon01.png\" alt=\"AWARD\" width=\"129\" height=\"70\"></span>\n                  <span class=\"title\">2023年北海道優秀照明施設賞受賞</span>\n                </h4>\n                <ul class=\"pickup-img\">\n                  <li><img src=\"/asset/img/campuslife/facility/pickup01-img01.jpg\" alt=\"\" width=\"540\" height=\"360\"></li>\n                  <li><img src=\"/asset/img/campuslife/facility/pickup01-img02.jpg\" alt=\"\" width=\"248\" height=\"248\"></li>\n                </ul>\n                <p class=\"catch anim fadeInUp\"><img src=\"/asset/img/campuslife/facility/pickup01-catch.png\" alt=\"Received the Excellence in Lighting Award 2023\" width=\"406\" height=\"144\"></p>\n              </div>\n              <div class=\"pickup-group group02\">\n                <h4 class=\"pickup-title\">\n                  <span class=\"title-icon anim fadeInUp\"><img src=\"/asset/img/campuslife/facility/2025/title-icon02.png\" alt=\"\" width=\"129\" height=\"70\"></span>\n                  <span class=\"title\">Netflix配信<span class=\"marker\">さよならの続き</span>の</span>\n                  <span class=\"title\">ロケ地になりました！</span>\n                </h4>\n                <ul class=\"pickup-img\">\n                  <li><img src=\"/asset/img/campuslife/facility/2025/pickup02-img01.jpg\" alt=\"\" width=\"360\" height=\"533\"></li>\n                  <li><img src=\"/asset/img/campuslife/facility/2025/pickup02-img02.jpg\" alt=\"\" width=\"248\" height=\"248\"></li>\n                  <li><img src=\"/asset/img/campuslife/facility/2025/pickup02-img03.jpg\" alt=\"\" width=\"248\" height=\"248\"></li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"slide-block01 bg-white\">\n          <div class=\"slide-inner\">\n            <div class=\"wrap\">\n              <div class=\"slide-box\"></div>\n            </div>\n            <p class=\"slide-catch catch01\">Enjoy a fun campus life!</p>\n            <p class=\"slide-catch catch02\">Enjoy a fun campus life!</p>\n          </div>\n        </div>\n\n        <div class=\"learning-block\">\n          <div class=\"wrap\">\n            <h3 class=\"learning-title\"><span class=\"inner\">最新設備が揃った<span class=\"dot\">学</span><span class=\"dot\">び</span><span class=\"dot\">の</span><span class=\"dot\">空</span><span class=\"dot\">間</span></span></h3>\n          </div>\n          <div class=\"learning-container\">\n            <div class=\"learning-group\">\n              <div class=\"learning-slide swiper-container no-pagination\">\n                <div class=\"swiper-wrapper\">\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning01-img01.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                </div>\n                <div class=\"swiper-pagination\"></div>\n              </div>\n              <div class=\"txt-box\">\n                <div class=\"wrap\">\n                  <p class=\"title\">看護実習室</p>\n                  <p>実際の病院と同様の設備環境を備えた実習室。安全・安楽な援助を提供するための看護技術を身につけます。</p>\n                </div>\n              </div>\n            </div>\n            <div class=\"learning-group reverse\">\n              <div class=\"learning-slide swiper-container\">\n                <div class=\"swiper-wrapper\">\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning02-img01.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning02-img02.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning02-img03.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                </div>\n                <div class=\"swiper-pagination\"></div>\n              </div>\n              <div class=\"txt-box\">\n                <div class=\"wrap\">\n                  <p class=\"title\">母性・小児在宅看護実習室</p>\n                  <p>保育器や小児用ベッド、沐浴槽を備え、主に母性看護・小児看護の演習を行います。また実際の住居に近い環境で、近年需要の増えている在宅でのケアを学ぶことができる環境も整っています。</p>\n                </div>\n              </div>            \n            </div>         \n          </div>\n          <div class=\"learning-container\">\n            <div class=\"learning-group\">\n              <div class=\"learning-slide swiper-container\">\n                <div class=\"swiper-wrapper\">\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning03-img01.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning03-img02.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                </div>\n                <div class=\"swiper-pagination\"></div>\n              </div>\n              <div class=\"txt-box\">\n                <div class=\"wrap\">\n                  <p class=\"title\">視能実習室</p>\n                  <p>電子視力表や検査機器を使用し、最新の眼科医療を学ぶことができます。</p>\n                </div>\n              </div>            \n            </div>\n            <div class=\"learning-group reverse\">\n              <div class=\"learning-slide swiper-container no-pagination\">\n                <div class=\"swiper-wrapper\">\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning04-img01.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                </div>\n                <div class=\"swiper-pagination\"></div>\n              </div>\n              <div class=\"txt-box\">\n                <div class=\"wrap\">\n                  <p class=\"title\">視能実習室（暗室）</p>\n                  <p>最新の眼科医療機器や道内養成校初の3D眼底カメラを備え、現場で必要な実践力を身につけます。</p>\n                </div>\n              </div>            \n            </div>         \n          </div>\n          <div class=\"learning-container\">\n            <div class=\"learning-group\">\n              <div class=\"learning-slide swiper-container no-pagination\">\n                <div class=\"swiper-wrapper\">\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning05-img01.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                </div>\n                <div class=\"swiper-pagination\"></div>\n              </div>\n              <div class=\"txt-box\">\n                <div class=\"wrap\">\n                  <p class=\"title\">歯科ユニット実習室</p>\n                  <p>最新のデジタルユニットを備えた実習室。ルーペやデジタルツールを使った最先端の技術を修得します。</p>\n                </div>\n              </div>            \n            </div>\n            <div class=\"learning-group reverse\">\n              <div class=\"learning-slide swiper-container\">\n                <div class=\"swiper-wrapper\">\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning06-img01.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning06-img02.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                </div>\n                <div class=\"swiper-pagination\"></div>\n              </div>\n              <div class=\"txt-box\">\n                <div class=\"wrap\">\n                  <p class=\"title\">歯科ファントム実習室</p>\n                  <p>一人一台の専用マネキンとモニターを使って基礎実習を行います。</p>\n                </div>\n              </div>            \n            </div>         \n          </div>\n          <div class=\"learning-container\">\n            <div class=\"learning-group\">\n              <div class=\"learning-slide swiper-container\">\n                <div class=\"swiper-wrapper\">\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning07-img01.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning07-img02.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                </div>\n                <div class=\"swiper-pagination\"></div>\n              </div>\n              <div class=\"txt-box\">\n                <div class=\"wrap\">\n                  <p class=\"title\">臨床工学実習室</p>\n                  <p>人工透析機器、人工心肺装置など病院で使われる最新の医療機器を備え、体験型実習で様々な現場に対応できる技術と知識を学びます。</p>\n                </div>\n              </div>            \n            </div>\n            <div class=\"learning-group reverse\">\n              <div class=\"learning-slide swiper-container no-pagination\">\n                <div class=\"swiper-wrapper\">\n                  <div class=\"swiper-slide\"><img src=\"/asset/img/campuslife/facility/learning08-img01.jpg\" alt=\"\" width=\"700\" height=\"466\"></div>\n                </div>\n                <div class=\"swiper-pagination\"></div>\n              </div>\n              <div class=\"txt-box\">\n                <div class=\"wrap\">\n                  <p class=\"title\">基礎工学実習室</p>\n                  <p>医療機器の原理・構造を学習するために電気・電子工学の実習を行い、必要となってくる装置の基本を学びます。</p>\n                </div>\n              </div>            \n            </div>         \n          </div>\n        </div>\n\n        <div class=\"slide-block02 bg-white\">\n          <div class=\"slide-box\"></div>\n        </div>\n\n        <div class=\"content-bg\"><img src=\"/asset/img/share/2025/content-bg.jpg\" loading=\"lazy\" alt=\"\" width=\"780\" height=\"1230\"></div>\n        <!-- /.content-body -->\n              </div><!-- /.main -->\n      \n     <footer>\n        <div class=\"footer bg-white\">\n                    <div class=\"ft-bottom-block\">\n            <div class=\"ft-body\">\n              <div class=\"ft-body-wrap\">\n                <div class=\"ft-info-box\">\n                  <h1 class=\"ft-siteid\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"476\" height=\"80\"></a></h1>\n                  <p class=\"address\">〒004-0051<br><span class=\"inline-block\">札幌市厚別区厚別中央1条5丁目1番5号</span></p>\n                  <p class=\"tel\">TEL：011-801-8343（代表番号）<br>FAX：011-801-8345<br>フリーダイヤル：0120-37-8343</p>\n                  <p class=\"info-txt\"><a href=\"/school/info/\" class=\"link-txt\">情報公開（職業実践専門課程）</a></p>\n                </div>\n                <div class=\"ft-link-box\">\n                  <ul class=\"contact-list\">\n                    <li>\n                      <a href=\"/form/inquiry/\">\n                        <span class=\"ft-mail-icon ft-icon\