 "bodyHtml": "\n  <!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-P994MCR\"\nheight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n<!-- End Google Tag Manager (noscript) -->\n\n<div id=\"ads-modal\" class=\"ads-modal-container\">\n  <div class=\"modal-content\">\n    <div class=\"close-button\"><img src=\"/asset/img/share/2026/button-ads-close.png\" loading=\"lazy\" alt=\"\" width=\"44\" height=\"44\"></div>\n        <a href=\"https://www.snm.ac.jp/news/2026/18962/\" class=\"banner ads-modal-banner\">\n      <img src=\"/asset/img/share/2026/banner-ads-oc01.jpg\" loading=\"lazy\" alt=\"オープンキャンパス\" width=\"295\" height=\"443\">\n    </a>\n      </div>\n</div><div class=\"contents-wrapper\">\n  <div class=\"contents-left\">\n    <div class=\"site-wrap\">\n  <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"238\" height=\"33\"></a></h1>\n  <p class=\"site-catch\"><img src=\"/asset/img/share/2025/site-catch.png\" alt=\"Future is yours\" width=\"310\" height=\"175\"></p>\n</div>      <div class=\"main-wrapper\">\n      \n    <header>\n      <input type=\"checkbox\" name=\"menu-switch\" id=\"menu-switch\" class=\"nav-checkbox\">\n      <div class=\"header\">\n        <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"420\" height=\"58\"></a></h1>\n        <div class=\"nav-block\">\n          <label for=\"menu-switch\" class=\"menu-btn\">\n            <span class=\"btn-label\">\n              <span></span><span></span><span></span>\n            </span>\n          </label>\n        </div>\n      </div>\n      <div class=\"sp-menu\">\n        <div class=\"inner\">\n          <ul class=\"sp-cv-btns\">\n            <li class=\"sp-cv-oc\">\n              <a href=\"/opencampus/\" class=\"banner\">\n                <span class=\"label\">オープン<br>キャンパス</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img01.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n                        <li class=\"sp-cv-request\">\n              <a href=\"/form/document/\" target=\"_blank\" rel=\"noopener\" class=\"no-icon banner\">\n                <span class=\"label\">資料請求</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img03.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n            <li class=\"sp-cv-special\">\n              <a href=\"/special/\" class=\"banner\">\n                <span class=\"label\">お仕事<br>紹介</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img04.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n          </ul>\n          <nav>\n            <ul class=\"sp-gnav\">\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav01\">\n                <label for=\"sp-nav01\" class=\"category-ttl\"><span class=\"en\">ABOUT</span>学校案内</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/school/\">学校案内 トップ</a></li>\n                  <li><a href=\"/school/study/\">札幌看護医療が選ばれる理由</a></li>\n                  <li><a href=\"/school/guide/\">高校1・2年生のための進路選び</a></li>\n                  <li><a href=\"/school/access/\">交通・アクセス</a></li>\n                  <li><a href=\"/school/philosophy/\">建学の理念</a></li>\n                  <li><a href=\"/school/info/\">情報公開（職業実践専門課程）</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav02\">\n                <label for=\"sp-nav02\" class=\"category-ttl\"><span class=\"en\">COURSE</span>学科・専攻</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/course/\">学科・専攻 トップ</a></li>\n                  <li><a href=\"/course/nursing/\">看護学科</a></li>\n                  <li><a href=\"/course/orthoptist/\">視能訓練士学科</a></li>\n                  <li><a href=\"/course/dentalhygienists/\">歯科衛生士学科<br>ホワイトニング・デンタルエステ専攻</a></li>\n                  <li><a href=\"/course/clinicalengineer/\">臨床工学技士学科</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav03\">\n                <label for=\"sp-nav03\" class=\"category-ttl\"><span class=\"en\">CARRER</span>資格・就職</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/career/\">資格・就職 トップ</a></li>\n                  <li><a href=\"/career/license_support/\">資格サポート</a></li>\n                  <li><a href=\"/career/job_result/\">就職サポート</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav04\">\n                <label for=\"sp-nav04\" class=\"category-ttl\"><span class=\"en\">CAMPUS LIFE</span>学校生活・施設</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/campuslife/\">学校生活・施設 トップ</a></li>\n                  <li><a href=\"/campuslife/schedule/\">キャンパスライフ</a></li>\n                  <li><a href=\"/campuslife/facility/\">施設紹介</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav05\">\n                <label for=\"sp-nav05\" class=\"category-ttl\"><span class=\"en\">ADMISSION</span>入試・学費</label>\n                <ul class=\"category-list txt-link\">\n                  <li><a href=\"/admission/\">入試・学費 トップ</a></li>\n                  <li><a href=\"/admission/application/\">募集要項・出願概要</a></li>\n                  <li><a href=\"/admission/ao/\">AO入試エントリー・AO入試出願方法</a></li>\n                  <li><a href=\"/admission/applicationflow/\">推薦・一般入試 出願方法</a></li>\n                  <li><a href=\"/admission/expenses/\">学費・奨学金制度</a></li>\n                  <li><a href=\"/admission/scholarship/\">特待生＆減免制度</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav06\">\n                <label for=\"sp-nav06\" class=\"category-ttl\"><span class=\"en\">OPEN CAMPUS</span>オープンキャンパス・説明会</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/opencampus/\">オープンキャンパスとは</a></li>\n                  <li><a href=\"/opencampus/calendar/\">イベント全日程一覧</a></li>\n                  <li><a href=\"/news/2026/17955/\">入試説明会</a></li>\n                  <li><a href=\"/opencampus/session/\">学校説明・個別相談会</a></li>\n                  <li><a href=\"/opencampus/bus/\">無料送迎バス</a></li>\n                  <li><a href=\"/opencampus/subsidy_list/\">交通費補助</a></li>\n                  <li><a href=\"/news/2026/18039/\">出張オープンキャンパス</a></li>\n                  <li><a href=\"/news/2021/5543/\">高校訪問ガイダンス</a></li>\n                </ul>\n              </li>\n                          </ul>\n          </nav>\n          <div class=\"sp-visitor-box\">\n            <input type=\"checkbox\" name=\"visitor-menu\" id=\"sp-visitor-menu\">\n            <label for=\"sp-visitor-menu\">\n              <span class=\"txt\">訪問者別メニュー</span>\n            </label>\n            <ul class=\"visitor-list\">\n              <li><a href=\"/visit_graduate/\">卒業生の方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9888/\">高等学校の先生方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9891/\">中学校の先生方へ</a></li>\n              <li><a href=\"/visit_society/\">社会人・大学生・短大生の方へ</a></li>\n              <li><a href=\"/visit_company/\">企業の方へ<span class=\"inline-block\">（求人掲載はコチラ）</span></a></li>\n              <li><a href=\"/recruit/\">職員募集につきまして</a></li>\n              <li><a href=\"/visit_municipality/\">産官学連携にご協力いただける企業・自治体の方へ</a></li>\n            </ul>\n          </div>\n          <ul class=\"sp-menu-btns\">\n            <li><a href=\"/form/inquiry/\"><span class=\"icon mail\"><img src=\"/asset/img/share/icon-mail.png\" alt=\"\" width=\"39\" height=\"28\"></span>お問い合わせ</a></li>\n            <li><a href=\"/school/access/\"><span class=\"icon access\"><img src=\"/asset/img/share/icon-access.png\" alt=\"\" width=\"28\" height=\"36\"></span>アクセス</a></li>\n          </ul>\n          <ul class=\"sp-other-btns\">\n            <li><a href=\"/school/info/\">情報公開(職業実践専門課程)</a></li>\n            <li><a href=\"/news/2024/11771/\">施設(教室)利用貸出につきまして</a></li>\n            <li><a href=\"/privacy/\">プライバシーポリシー</a></li>\n            <li><a href=\"/recruit/\">採用情報</a></li>\n            <li><a href=\"/sitemap/\">サイトマップ</a></li>\n            <li><a href=\"/socialpolicy/\">ソーシャルメディアポリシー</a></li>\n          </ul>\n        </div>\n        <div class=\"sns-link-box\">\n          <div class=\"sns-item instagram\">\n            <a href=\"https://www.instagram.com/sapporo_kango/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-instagram.png\" alt=\"\" width=\"58\" height=\"58\">\n            </a>\n          </div>\n          <div class=\"sns-item tiktok\">\n            <a href=\"https://www.tiktok.com/@sapporo_kango\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-tiktok.png\" alt=\"\" width=\"41\" height=\"48\">\n            </a>\n          </div>\n          <div class=\"sns-item youtube\">\n            <a href=\"https://www.youtube.com/channel/UCQU3cRE2T7qim5OOqXSDjww\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-youtube.png\" alt=\"\" width=\"55\" height=\"39\">\n            </a>\n          </div>\n          <div class=\"sns-item line\">\n            <a href=\"https://lin.ee/kxlpB4B\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-line.png\" alt=\"\" width=\"56\" height=\"56\">\n            </a>\n          </div>\n        </div>\n      </div>\n    </header>\n      <div class=\"main admission application\">\n        <div class=\"mv mv-block\">\n          <div class=\"wrap\">\n            <h1 class=\"page-ttl\">\n              <span class=\"text-wrap\">\n                <span class=\"eng\">ADMISSION</span>\n                <span class=\"ja\">募集要項・出願概要</span>\n              </span>\n            </h1>\n          </div>\n          <div class=\"bg-box\"><img src=\"/asset/img/admission/share/2025/mv.jpg\" alt=\"\" width=\"740\" height=\"330\"></div>\n        </div>\n                <div class=\"content-block no-lead\">\n          <div class=\"wrap\">\n                      <div class=\"content-box\">\n              <ul class=\"banner-list col2\" style=\"margin-top: 0; justify-content: center;\">\n                <li>\n                  <a href=\"https://www.snm.ac.jp/news/2025/14409/\" class=\"banner\">\n                    <img src=\"/asset/img/share/2026/banner-aoentry.png\" width=\"330\" height=\"310\" alt=\"AO入試＆＆エントリー徹底解説！\">\n                  </a>\n                </li>\n                <li>\n                  <a href=\"https://www.snm.ac.jp/news/2026/17955/\" class=\"banner\">\n                    <img src=\"/asset/img/share/2026/banner-examination.png\" width=\"330\" height=\"310\" alt=\"入試説明会\">\n                  </a>\n                </li>\n              </ul>\n            </div>\n            <div class=\"content-box\">\n              <h3 class=\"content-ttl02 mt0\">募集人数・修業年限</h3>\n              <table class=\"common-tbl text-center\">\n                <tbody>\n                  <tr>\n                    <th class=\"w40\">学科名</th>\n                    <th class=\"w30\">募集人員</th>\n                    <th class=\"w30\">修業年限</th>\n                  </tr>\n                  <tr>\n                    <td class=\"text-left\">看護学科</td>\n                    <td>80名</td>\n                    <td>3年</td>\n                  </tr>\n                  <tr>\n                    <td class=\"text-left\">視能訓練士学科</td>\n                    <td>44名</td>\n                    <td>3年</td>\n                  </tr>\n                  <tr>\n                    <td class=\"text-left\">歯科衛生士学科</td>\n                    <td>44名</td>\n                    <td>3年</td>\n                  </tr>\n                  <tr>\n                    <td class=\"text-left\">臨床工学技士学科</td>\n                    <td>40名</td>\n                    <td>3年</td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n\n            <div class=\"content-box\">\n              <h3 class=\"content-ttl02\">出願資格について</h3>\n              <ol>\n                <li>①2027年3月高等学校を卒業見込み、または高等学校を卒業している方。</li>\n                <li>②2027年3月までに高等学校卒業程度認定試験に合格、または合格見込みの方</li>\n                <li>③18歳以上で高等学校卒業者と同等以上の学力があると認められた方</li>\n              </ol>\n            </div>\n\n            <div class=\"content-box\">\n              <h3 class=\"content-ttl02\">出願書類一覧・提出方法</h3>\n              <div class=\"content-inner\">\n                <ul class=\"list-disc\">\n                  <li>出願書類受付締切：各入学試験日のネット出願受付期間の最終日到着分まで</li>\n                  <li><span>郵送による提出：郵便窓口より<span class=\"txt-red\">「簡易書留」</span>にてお送りください（指定の封筒はありません）。<br>【提出先】<br>〒004-0051<br>札幌市厚別区厚別中央1条5丁目1-5<br>札幌看護医療専門学校 入学事務局宛</span></li>\n                  <li>持参による提出：受付時間内に本校窓口へ持参してください。<br>受付時間（平日）9:00～17:00<br>※受付時間外・土日祝に持参希望の場合は、必ず事前にお電話にてご相談ください（TEL:0120-37-8343）。</li>\n                  <li class=\"txt-red\">出願書類・選考料入金の確認ができ次第、本校より受験票を発行（メールにて送付）します。</li>\n                </ul>\n              </div>\n              <div class=\"content-inner\">\n                <table class=\"common-tbl admission-tbl\">\n                  <thead>\n                    <tr>\n                      <th class=\"w20\">出願書類</th>\n                      <th class=\"w20\">提出方法</th>\n                      <th>AO入試（総合型選抜）</th>\n                      <th>指定校・高校<span class=\"inline-block\">（公募）</span><br>推薦入試</th>\n                      <th>業界推薦入試</th>\n                      <th>一般入試</th>\n                      <th>社会人入試</th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    <tr>\n                      <th>入学願書</th>\n                      <td>ネット出願フォーム入力</td>\n                      <td class=\"txt-center\">○</td>\n                      <td class=\"txt-center\">○</td>\n                      <td class=\"txt-center\">○</td>\n                      <td class=\"txt-center\">○</td>\n                      <td class=\"txt-center\">○</td>\n                    </tr>\n                    <tr>\n                      <th>調査書<br><small>厳封したもの</small></th>\n                      <td rowspan=\"3\">郵送または<span class=\"inline-block\">持参</span></td>\n                      <td class=\"txt-center\">○</td>\n                      <td class=\"txt-center\">○</td>\n                      <td class=\"txt-center\">○</td>\n                      <td class=\"txt-center\">○</td>\n                      <td class=\"txt-center\">○</td>\n                    </tr>\n                    <tr>\n                      <th>推薦書<br><small>厳封したもの</small></th>\n                      <td class=\"txt-center\">-</td>\n                      <td class=\"txt-center\">○</td>\n                      <td class=\"txt-center\">○</td>\n                      <td class=\"txt-center\">-</td>\n                      <td class=\"txt-center\">-</td>\n                    </tr>\n                    <tr>\n                      <th>大学・<span class=\"inline-block\">短大・</span><span class=\"inline-block\">専門学校等</span><br>卒業<span class=\"inline-block\">証明書</span><br><small>厳封したもの</small></th>\n                      <td colspan=\"5\" class=\"txt-center\">該当される方のみ提出必要</td>\n                    </tr>\n                    <tr>\n                      <th>選考料</th>\n                      <td>コンビニまたはクレジットカード決済</td>\n                      <td colspan=\"5\" class=\"txt-center\">30,000円</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n              <div class=\"content-inner\">\n                <table class=\"common-tbl admission-tbl\">\n                  <tbody>\n                    <tr>\n                      <th class=\"w25\"></th>\n                      <th>内容・備考</th>\n                    </tr>\n                    <tr>\n                      <th>入学願書</th>\n                      <td>\n                        <ul class=\"list-disc\">\n                          <li>証明写真データ（正面上半身、無帽、無背景、制服または正装で3カ月以内に撮影したもの）のアップロードが必要です。</li>\n                        </ul>\n                      </td>\n                    </tr>\n                    <tr>\n                      <th>調査書<br><small>厳封したもの</small></th>\n                      <td>\n                        <ul class=\"list-disc\">\n                          <li>出願資格②の方は合格成績証明書または合格見込成績証明書が必要となります。</li>\n                          <li>既卒の方で卒業後5年以上経過し調査書（成績証明書）が発行されない場合は、卒業証明書（発行日から6ヶ月以内）を提出してください。</li>\n                        </ul>\n                      </td>\n                    </tr>\n                    <tr>\n                      <th>推薦書<br><small>厳封したもの</small></th>\n                      <td>\n                        <p class=\"mb01\">オープンキャンパス等で配布された、もしくは、本校HPよりダウンロードした「推薦書」に必要事項を記入してご提出ください。</p>\n                        <div class=\"txt-center\"><a href=\"/asset/doc/admission/share/recommendation.pdf\" target=\"_blank\" rel=\"noopener\" class=\"button yellow\">推薦書ダウンロードはこちら<span class=\"arrow short\"></span></a></div>\n                      </td>\n                    </tr>\n                    <tr>\n                      <th>大学・短大・<span class=\"inline-block\">専門学校等</span><br>卒業証明書<br><small>厳封したもの</small></th>\n                      <td>発行日から6カ月以内のものをご提出ください。<br>オンラインで発行した証明書は厳封不要です。</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n              <ul class=\"notes\">\n                <li>AO入試（総合型選抜）第1期の出願期間（9/1〜9/24）については、調査書以外の出願書類が揃い次第、受験票を発行します。調査書に関して、ネット出願受付期間内に提出が難しい場合は事前連絡の上、10/15（木）までに提出してください。提出確認後に合否通知・手続きのご案内をお送りします。</li>\n                <li>再受験の場合は、調査書もしくは卒業証明書の再提出は必要ありません（選考料はかかります）。</li>\n                <li>留学生・外国人の方は、事前審査と別途出願書類（日本語能力試験N1もしくはN2取得証明書のコピー等）が必要ですので、出願前に入学事務局までお問い合わせください。</li>\n              </ul>\n            </div>\n\n            <div class=\"content-box\">\n              <h3 class=\"content-ttl02\">出願概要</h3>\n                            <div class=\"content-inner\">\n                <h4 class=\"content-ttl03\">看護学科　<small>※看護学科は、AO入試はありません</small></h4>\n                <table class=\"common-tbl admission-tbl\">\n                  <thead>\n                    <tr>\n                      <th class=\"w15\">入試方法</th>\n                      <th>選考方法</th>\n                      <th>対象者</th>\n                      <th>選考料</th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    <tr>\n                      <td>指定校<span class=\"inline-block\">推薦</span><span class=\"inline-block\">入試</span></td>\n                      <td>書類選考</td>\n                      <td>本校を専願し、オープンキャンパス・入試説明会・学校説明会のいずれかに1回以上参加した者。<br>\n                        <small>※詳細は在籍高等学校の進路指導担当の先生へご確認ください。</small></td>\n                      <td rowspan=\"5\">30,000円<br>（ネット出願受付期間内にお支払いください）</td>\n                    </tr>\n                    <tr>\n                      <td>高校（公募）<span class=\"inline-block\">推薦</span><span class=\"inline-block\">入試</span></td>\n                      <td>小論文／<span class=\"inline-block\">面接</span></td>\n                      <td>本校を専願し、3学年までの学習評価がB段階で3.5以上かつ在籍高等学校の学校長が推薦する者。</td>\n                    </tr>\n                    <tr>\n                      <td>業界<span class=\"inline-block\">推薦</span><span class=\"inline-block\">入試</span></td>\n                      <td>小論文／<span class=\"inline-block\">面接</span></td>\n                      <td>\n                        <ul class=\"list-disc whitespace-normal\">\n                          <li>本校を専願し、2027年3月に大学・短大・専門学校等を卒業見込みで、在籍学校長が推薦する者。</li>\n                          <li>本校を専願し、保健医療機関施設・福祉施設に現在勤務している者、または勤務していた者のうち、責任者（理事長、病院長、施設長等）が推薦する者。</li>\n                        </ul>\n                      </td>\n                    </tr>\n                    <tr>\n                      <td>一般<span class=\"inline-block\">入試</span></td>\n                      <td>筆記：国語（必須）、数学Ⅰ·Aまたは英語（選択）／面接</td>\n                      <td>出願資格を満たす者。</td>\n                    </tr>\n                    <tr>\n                      <td>社会人<span class=\"inline-block\">入試</span></td>\n                      <td>筆記：国語（必須）、数学Ⅰ·Aまたは英語（選択）／面接</td>\n                      <td>本校を専願し、高等学校卒業以上で、10月1日時点で1年以上の就業経験のある者。</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n\n              <div class=\"content-inner\">\n                <p class=\"content-ttl05\">＜看護学科の出願に関する補足説明＞</p>\n                <p class=\"mb1\"><b>○選考方法について</b></p>\n                <ul class=\"list-disc\">\n                  <li>高校（公募）推薦入試・業界推薦入試は小論文（50分•600字）／集団面接（グループディスカッション）・個人面接 各15分程度です。</li>\n                  <li>一般入試・社会人入試は筆記：国語（古文・漢文を除く50分）必須、数学Ⅰ・A（50分）または英語（50分）を出願時に選択／集団面接（グループディスカッション）・個人面接各15分程度です。</li>\n                </ul>\n                <ul class=\"notes\">\n                  <li>出願後の筆記試験科目の変更はできません。</li>\n                  <li>看護学科を受験し、不合格であった場合、別日程での再受験も可能です。その場合調査書、もしくは卒業証明書の再提出の必要はありません（選考料はかかります）。</li>\n                </ul>\n              </div>\n              <div class=\"content-inner\">\n                <p class=\"content-ttl05\">＜複数学科志望同時選考制度のお知らせ＞<br>【高校（公募）推薦入試・業界推薦入試・一般入試・社会人入試】</p>\n                <p>看護学科を第1志望で、本校の他学科を第2・第3志望として同時に選考を受けることが可能です。</p>\n                <ul class=\"notes mb-4\"><li>入学願書の「第2・第3志望欄」に入力してください。入学試験時に記入することもできます。</li></ul>\n              </div>\n            </div>\n\n            <div class=\"content-box\">\n              <ul class=\"banner-list\">\n                <li>\n                  <a href=\"/course/clinicalengineer/\" class=\"banner\"><img src=\"/asset/img/share/2026/banner-course-clinicalengineer.png\" width=\"330\" height=\"310\" alt=\"いま注目の医療職 臨床工学技士学科\" loading=\"lazy\"></a>\n                </li>\n                <li>\n                  <a href=\"/course/orthoptist/\" class=\"banner\"><img src=\"/asset/img/share/2026/banner-course-orthoptist.png\" width=\"330\" height=\"310\" alt=\"女性に人気の医療職 視能訓練士学科\" loading=\"lazy\"></a>\n                </li>\n                <li>\n                  <a href=\"/course/dentalhygienists/\" class=\"banner\"><img src=\"/asset/img/share/2026/banner-course-dentalhygienists.png\" width=\"330\" height=\"310\" alt=\"\" loading=\"lazy\"></a>\n                </li>\n              </ul>\n            </div>\n\n            <div class=\"content-box\">\n              <p class=\"content-ttl04\">入学試験日</p>\n              <p><b>出願書類受付締切：各入学試験日のネット出願受付期間の最終日到着分まで。</b></p>\n              <ul class=\"notes txt-red\">\n                <li>定員に達した場合は募集を締切ります。募集状況は本校ホームページに掲載いたしますので、お問い合わせはお控えください。</li>\n                <li>調査書など持参の場合はネット出願受付期間内（平日）9:00～17:00までに本校窓口へご提出ください。<br>受付時間外・土日祝に持参希望の場合は、必ず事前にお電話にてこ相談ください（TEL: 0120-37-8343）。</li>\n                <li>指定校推薦入試は書類選考のため、来校不要です（特待生試験を希望する場合は、入学試験日に実施するため、ご来校ください）。</li>\n                <li>特待生試験（希望者のみ）は指定校推薦入試・高校（公募）推薦入試の方のみとなります。</li>\n              </ul>\n              <div class=\"content-inner\">\n                <table class=\"common-tbl admission-tbl\">\n                  <tbody>\n                    <tr>\n                      <th>入学試験日</th>\n                      <td>2026年<br>10/18（日）</td>\n                      <td>2026年<br>11/8（日）</td>\n                      <td>2026年<br>12/6（日）</td>\n                      <td>2027年<br>1/23（土）</td>\n                    </tr>\n                    <tr>\n                      <th>ネット出願受付期間</th>\n                      <td>10/1（木）～10/15（木）</td>\n                      <td>10/1（水）～11/5（木）</td>\n                      <td>11/9（月）～12/3（木）</td>\n                      <td>12/7（月）～1/21（木）</td>\n                    </tr>\n                    <tr>\n                      <th>指定校・高校（公募）・業界推薦入試</th>\n                      <td class=\"txt-center\">◯</td>\n                      <td></td>\n                      <td></td>\n                      <td></td>\n                    </tr>\n                    <tr>\n                      <th>一般入試</th>\n                      <td></td>\n                      <td class=\"txt-center\">◯</td>\n                      <td class=\"txt-center\">◯</td>\n                      <td class=\"txt-center\">◯</td>\n                    </tr>\n                    <tr>\n                      <th>社会人入試</th>\n                      <td class=\"txt-center\">◯</td>\n                      <td></td>\n                      <td></td>\n                      <td class=\"txt-center\">◯</td>\n                    </tr>\n                    <tr>\n                      <th>特待生試験<br>（希望者のみ）</th>\n                      <td class=\"txt-center\">◯<br>（筆記）</td>\n                      <td class=\"txt-center\">ー</td>\n                      <td class=\"txt-center\">ー</td>\n                      <td class=\"txt-center\">ー</td>\n                    </tr>\n                    <tr>\n                      <th>入学手続き（学費納入）<span class=\"inline-block\">締切日</span></th>\n                      <td class=\"txt-center\">11月上旬</td>\n                      <td class=\"txt-center\">11月下旬</td>\n                      <td class=\"txt-center\">12月下旬</td>\n                      <td class=\"txt-center\">2月中旬</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n              <div class=\"content-inner\">\n                <ul class=\"notes txt-red\">\n                  <li>推薦受験者が同一学科を再受験する場合は一般受験となります。</li>\n                </ul>\n              </div>\n              <div class=\"content-inner\">\n                <p class=\"content-ttl05\">＜合否について＞</p>\n                <p>入学試験日より2週間以内に合否通知をお送りします。合格者には「学費振込依頼書」を合わせてお送りします。</p>\n                <ul class=\"notes\">\n                  <li>特待生試験を受験の方は、入学選考と特待生試験の結果を一緒にお送りします。</li>\n                </ul>\n                <ul class=\"list-disc\">\n                  <li>合否についての電話でのお問い合わせは応じておりません。</li>\n                  <li>合格者には、合格通知、学費（入学金、授業料、実習費、施設設備費）振込依頼書をお送りします。</li>\n                  <li>お送りする所定の振込用紙を使用して、期日まで（合格通知発行日から2週間以内が目安）に納入を完了してください。</li>\n                  <li>事情により入学を辞退される場合は、必ず入学事務局までご連絡ください。</li>\n                </ul>\n              </div>\n            </div>\n                        <div class=\"content-box\">\n              <h4 class=\"content-ttl03\">視能訓練士学科／歯科衛生士学科／臨床工学技士<span class=\"inline-block\">学科</span></h4>\n              <table class=\"common-tbl admission-tbl\">\n                <thead>\n                  <tr>\n                    <th class=\"w15\">入試方法</th>\n                    <th>選考方法</th>\n                    <th>対象者</th>\n                    <th>選考料</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <td>AO入試（総合型選抜）</td>\n                    <td>AO<span class=\"inline-block\">審査</span><span class=\"inline-block\">(面談)</span></td>\n                    <td>オープンキャンパス・入試説明会・学校説明会のいずれかに1回以上参加した者。</td>\n                    <td rowspan=\"5\">30,000円<br>（ネット出願受付期間内にお支払いください）</td>\n                  </tr>\n                  <tr>\n                    <td>指定校推薦<span class=\"inline-block\">入試</span></td>\n                    <td>書類選考</td>\n                    <td>本校を専願し、オープンキャンパス・入試説明会・学校説明会のいずれかに1回以上参加した者。<br>※詳細は、在籍高等学校の進路指導担当の先生へご確認ください。</td>\n                  </tr>\n                  <tr>\n                    <td>高校（公募）推薦<span class=\"inline-block\">入試</span></td>\n                    <td>小論文／面接</td>\n                    <td>本校を専願し、在籍高等学校の学校長が推薦する者。</td>\n                  </tr>\n                  <tr>\n                    <td>業界推薦<span class=\"inline-block\">入試</span></td>\n                    <td>小論文／面接</td>\n                    <td>\n                      <ul class=\"list-disc whitespace-normal\">\n                        <li>本校を専願し、2027年3月に大学・短大・専門学校等を卒業見込みで、在籍学校長が推薦する者。</li>\n                        <li>本校を専願し、保健医療機関施設・福祉施設に現在勤務している者、または勤務していた者のうち責任者（理事長、病院長、施設長等）が推薦する者。</li>\n                      </ul>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>一般<span class=\"inline-block\">入試</span></td>\n                    <td>小論文／面接</td>\n                    <td>出願資格を満たす者。</td>\n                  </tr>\n                </tbody>\n              </table>\n              <div class=\"content-inner\">\n                <p class=\"content-ttl05\">＜出願に関する補足説明＞</p>\n                <p><b>高校（公募）推薦入試・業界推薦入試・一般入試は、小論文（50分・600字）／個人面接（20分程度）です。</b></p>\n                <ul class=\"notes txt-red\">\n                  <li>推薦入試受験者が同一学科を再受験する場合は一般入試での受験となります。その場合調査書、もしくは卒業証明書の再提出は必要ありません（選考料はかかります）。</li>\n                </ul>\n              </div>\n            </div>\n\n            <div class=\"content-box\">\n              <p class=\"content-ttl04\">入学試験日</p>\n              <p><b>出願書類受付締切：各入学試験日のネット出願受付期間の最終日到着分まで。</b></p>\n              <ul class=\"notes txt-red\">\n                <li>定員に達した場合は募集を締切ります。募集状況は学校ホームページに掲載いたしますので、お問い合わせはお控えください。</li>\n                <li>調査書など持参の場合はネット出願受付期間内（平日）9:00～17:00までに本校窓口へご提出ください。<br>受付時間外・土日祝に持参希望の場合は、必ず事前にお電話にてこ相談ください（TEL: 0120-37-8343）。</li>\n                <li>指定校推薦入試は書類選考のため、来校不要です（特待生試験を希望する場合は、入学試験日に実施するため、ご来校ください）。</li>\n                <li>特待生試験（希望者のみ）はAO入試（総合型選抜）・指定校推薦入試・高校（公募）推薦入試の方のみとなります。</li>\n              </ul>\n              <div class=\"content-inner scroll-tbl\" data-simplebar=\"\" data-simplebar-auto-hide=\"false\">\n                <table class=\"common-tbl admission-tbl\">\n                  <tbody>\n                    <tr>\n                      <th>入学試験日</th>\n                      <td>2026年<br>9/27（日）</td>\n                      <td>2026年<br>10/18（日）</td>\n                      <td>2026年<br>11/8（日）</td>\n                      <td>2026年<br>12/6（日）</td>\n                      <td>2027年<br>1/9（土）</td>\n                      <td>2027年<br>1/23（土）</td>\n                      <td>2027年<br>2/13（土）</td>\n                      <td>2027年<br>2/27（土）</td>\n                    </tr>\n                    <tr>\n                      <th>ネット出願受付期間</th>\n                      <td>9/1（火）～9/24（木）</td>\n                      <td>9/28（月）～10/15（木）</td>\n                      <td>10/19（月）～11/5（木）</td>\n                      <td>11/9（月）～12/3（木）</td>\n                      <td>12/7（月）～1/7（木）</td>\n                      <td>1/11（月・祝）～1/21（木）</td>\n                      <td>1/25（月）～2/11（木・祝）</td>\n                      <td>2/15（月）～2/25（木）</td>\n                    </tr>\n                    <tr>\n                      <th>AO入試（総合型選抜）</th>\n                      <td class=\"txt-center\">第1期<br>◯</td>\n                      <td class=\"txt-center\">第2期<br>◯</td>\n                      <td class=\"txt-center\">第3期<br>◯</td>\n                      <td class=\"txt-center\">第4期<br>◯</td>\n                      <td class=\"txt-center\">第5期<br>◯</td>\n                      <td></td>\n                      <td></td>\n                      <td></td>\n                    </tr>\n                    <tr>\n                      <th>指定校・高校（公募）・業界推薦入試</th>\n                      <td></td>\n                      <td class=\"txt-center\">10/1（木）〜<br>◯</td>\n                      <td></td>\n                      <td></td>\n                      <td></td>\n                      <td></td>\n                      <td></td>\n                      <td></td>\n                    </tr>\n                    <tr>\n                      <th>一般入試</th>\n                      <td></td>\n                      <td class=\"txt-center\">10/1（木）〜<br>◯</td>\n                      <td class=\"txt-center\">◯</td>\n                      <td class=\"txt-center\">◯</td>\n                      <td class=\"txt-center\">◯</td>\n                      <td class=\"txt-center\">◯</td>\n                      <td class=\"txt-center\">◯</td>\n                      <td class=\"txt-center\">◯</td>\n                    </tr>\n                    <tr>\n                      <th>特待生試験<br>（希望者のみ）</th>\n                      <td class=\"txt-center\">第1期<br>◯</td>\n                      <td class=\"txt-center\">第2期<br>◯</td>\n                      <td class=\"txt-center\">第3期<br>◯</td>\n                      <td class=\"txt-center\">第4期<br>◯</td>\n                      <td class=\"txt-center\">第5期<br>◯</td>\n                      <td></td>\n                      <td></td>\n                      <td></td>\n                    </tr>\n                    <tr>\n                      <th>入学手続き（学費納入）締切日</th>\n                      <td class=\"txt-center\">10月中旬頃</td>\n                      <td class=\"txt-center\">11月上旬</td>\n                      <td class=\"txt-center\">11月下旬</td>\n                      <td class=\"txt-center\">12月下旬</td>\n                      <td class=\"txt-center\">1月下旬</td>\n                      <td class=\"txt-center\">2月中旬</td>\n                      <td class=\"txt-center\">2月下旬</td>\n                      <td class=\"txt-center\">3月上旬</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n              <div class=\"content-inner\">\n                <ul class=\"notes txt-red\">\n                  <li>推薦受験者が同一学科を再受験する場合は一般入試での受験となります。その場合調査書、もしくは卒業証明書の再提出の必要はありません（選考料はかかります）。</li>\n                </ul>\n              </div>\n                            <div class=\"content-inner\">\n                <p class=\"content-ttl05\">＜合否について＞</p>\n                <p>入学試験日より2週間以内に合否通知をお送りします。合格者には「学費振込依頼書」を合わせてお送りします。</p>\n                <ul class=\"notes\">\n                  <li>特待生試験を受験の方は、入学選考と特待生試験の結果を一緒にお送りします。</li>\n                </ul>\n                <ul class=\"list-disc\">\n                  <li>合否についての電話でのお問い合わせは応じておりません。</li>\n                  <li>合格者には、合格通知、学費（入学金、授業料、実習費、施設設備費）振込依頼書をお送りします。</li>\n                  <li>お送りする所定の振込用紙を使用して、期日まで（合格通知発行日から2週間以内が目安）に納入を完了してください。</li>\n                  <li>事情により入学を辞退される場合は、必ず入学事務局までご連絡ください。</li>\n                </ul>\n              </div>\n            </div>\n                        <div class=\"content-box\">\n              <h3 class=\"content-ttl02 mt-12\">【お知らせ】<span class=\"inline-block\">「一人ひとりを大切に」　滋慶学園グループにおける合理的配慮について</span></h3>\n              <p>滋慶学園グループにおける合理的配慮については、<a href=\"/asset/doc/admission/application/hairyo.pdf\" target=\"_blank\" rel=\"noopener noreferrer\">こちら</a>をご参照ください。</p>\n            </div>\n\n          </div>\n        </div>\n\n      </div><!-- /.main -->\n      \n     <footer>\n        <div class=\"footer bg-white\">\n                    <div class=\"ft-bottom-block\">\n            <div class=\"ft-body\">\n              <div class=\"ft-body-wrap\">\n                <div class=\"ft-info-box\">\n                  <h1 class=\"ft-siteid\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"476\" height=\"80\"></a></h1>\n                  <p class=\"address\">〒004-0051<br><span class=\"inline-block\">札幌市厚別区厚別中央1条5丁目1番5号</span></p>\n                  <p class=\"tel\">TEL：011-801-8343（代表番号）<br>FAX：011-801-8345<br>フリーダイヤル：0120-37-8343</p>\n                  <p class=\"info-txt\"><a href=\"/school/info/\" class=\"link-txt\">情報公開（職業実践専門課程）</a></p>\n                </div>\n                <div class=\"ft-link-box\">\n                  <ul class=\"contact-list\">\n                    <li>\n                      <a href=\"/form/inquiry/\">\n                        <span class=\"ft-mail-icon ft-icon\"><img src=\"/asset/img/share/ft-mail-icon.png\" alt=\"\" width=\"34\" height=\"24\"></span>\n                        <span class=\"text\">お問い合わせ</span>\n                      </a>\n                    </li>\n               