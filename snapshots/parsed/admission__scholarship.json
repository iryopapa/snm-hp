 "bodyHtml": "\n  <!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-P994MCR\"\nheight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n<!-- End Google Tag Manager (noscript) -->\n\n<div id=\"ads-modal\" class=\"ads-modal-container\">\n  <div class=\"modal-content\">\n    <div class=\"close-button\"><img src=\"/asset/img/share/2026/button-ads-close.png\" loading=\"lazy\" alt=\"\" width=\"44\" height=\"44\"></div>\n        <a href=\"https://www.snm.ac.jp/news/2026/18962/\" class=\"banner ads-modal-banner\">\n      <img src=\"/asset/img/share/2026/banner-ads-oc01.jpg\" loading=\"lazy\" alt=\"オープンキャンパス\" width=\"295\" height=\"443\">\n    </a>\n      </div>\n</div><div class=\"contents-wrapper\">\n  <div class=\"contents-left\">\n    <div class=\"site-wrap\">\n  <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"238\" height=\"33\"></a></h1>\n  <p class=\"site-catch\"><img src=\"/asset/img/share/2025/site-catch.png\" alt=\"Future is yours\" width=\"310\" height=\"175\"></p>\n</div>      <div class=\"main-wrapper\">\n      \n    <header>\n      <input type=\"checkbox\" name=\"menu-switch\" id=\"menu-switch\" class=\"nav-checkbox\">\n      <div class=\"header\">\n        <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"420\" height=\"58\"></a></h1>\n        <div class=\"nav-block\">\n          <label for=\"menu-switch\" class=\"menu-btn\">\n            <span class=\"btn-label\">\n              <span></span><span></span><span></span>\n            </span>\n          </label>\n        </div>\n      </div>\n      <div class=\"sp-menu\">\n        <div class=\"inner\">\n          <ul class=\"sp-cv-btns\">\n            <li class=\"sp-cv-oc\">\n              <a href=\"/opencampus/\" class=\"banner\">\n                <span class=\"label\">オープン<br>キャンパス</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img01.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n                        <li class=\"sp-cv-request\">\n              <a href=\"/form/document/\" target=\"_blank\" rel=\"noopener\" class=\"no-icon banner\">\n                <span class=\"label\">資料請求</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img03.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n            <li class=\"sp-cv-special\">\n              <a href=\"/special/\" class=\"banner\">\n                <span class=\"label\">お仕事<br>紹介</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img04.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n          </ul>\n          <nav>\n            <ul class=\"sp-gnav\">\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav01\">\n                <label for=\"sp-nav01\" class=\"category-ttl\"><span class=\"en\">ABOUT</span>学校案内</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/school/\">学校案内 トップ</a></li>\n                  <li><a href=\"/school/study/\">札幌看護医療が選ばれる理由</a></li>\n                  <li><a href=\"/school/guide/\">高校1・2年生のための進路選び</a></li>\n                  <li><a href=\"/school/access/\">交通・アクセス</a></li>\n                  <li><a href=\"/school/philosophy/\">建学の理念</a></li>\n                  <li><a href=\"/school/info/\">情報公開（職業実践専門課程）</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav02\">\n                <label for=\"sp-nav02\" class=\"category-ttl\"><span class=\"en\">COURSE</span>学科・専攻</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/course/\">学科・専攻 トップ</a></li>\n                  <li><a href=\"/course/nursing/\">看護学科</a></li>\n                  <li><a href=\"/course/orthoptist/\">視能訓練士学科</a></li>\n                  <li><a href=\"/course/dentalhygienists/\">歯科衛生士学科<br>ホワイトニング・デンタルエステ専攻</a></li>\n                  <li><a href=\"/course/clinicalengineer/\">臨床工学技士学科</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav03\">\n                <label for=\"sp-nav03\" class=\"category-ttl\"><span class=\"en\">CARRER</span>資格・就職</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/career/\">資格・就職 トップ</a></li>\n                  <li><a href=\"/career/license_support/\">資格サポート</a></li>\n                  <li><a href=\"/career/job_result/\">就職サポート</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav04\">\n                <label for=\"sp-nav04\" class=\"category-ttl\"><span class=\"en\">CAMPUS LIFE</span>学校生活・施設</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/campuslife/\">学校生活・施設 トップ</a></li>\n                  <li><a href=\"/campuslife/schedule/\">キャンパスライフ</a></li>\n                  <li><a href=\"/campuslife/facility/\">施設紹介</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav05\">\n                <label for=\"sp-nav05\" class=\"category-ttl\"><span class=\"en\">ADMISSION</span>入試・学費</label>\n                <ul class=\"category-list txt-link\">\n                  <li><a href=\"/admission/\">入試・学費 トップ</a></li>\n                  <li><a href=\"/admission/application/\">募集要項・出願概要</a></li>\n                  <li><a href=\"/admission/ao/\">AO入試エントリー・AO入試出願方法</a></li>\n                  <li><a href=\"/admission/applicationflow/\">推薦・一般入試 出願方法</a></li>\n                  <li><a href=\"/admission/expenses/\">学費・奨学金制度</a></li>\n                  <li><a href=\"/admission/scholarship/\">特待生＆減免制度</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav06\">\n                <label for=\"sp-nav06\" class=\"category-ttl\"><span class=\"en\">OPEN CAMPUS</span>オープンキャンパス・説明会</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/opencampus/\">オープンキャンパスとは</a></li>\n                  <li><a href=\"/opencampus/calendar/\">イベント全日程一覧</a></li>\n                  <li><a href=\"/news/2026/17955/\">入試説明会</a></li>\n                  <li><a href=\"/opencampus/session/\">学校説明・個別相談会</a></li>\n                  <li><a href=\"/opencampus/bus/\">無料送迎バス</a></li>\n                  <li><a href=\"/opencampus/subsidy_list/\">交通費補助</a></li>\n                  <li><a href=\"/news/2026/18039/\">出張オープンキャンパス</a></li>\n                  <li><a href=\"/news/2021/5543/\">高校訪問ガイダンス</a></li>\n                </ul>\n              </li>\n                          </ul>\n          </nav>\n          <div class=\"sp-visitor-box\">\n            <input type=\"checkbox\" name=\"visitor-menu\" id=\"sp-visitor-menu\">\n            <label for=\"sp-visitor-menu\">\n              <span class=\"txt\">訪問者別メニュー</span>\n            </label>\n            <ul class=\"visitor-list\">\n              <li><a href=\"/visit_graduate/\">卒業生の方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9888/\">高等学校の先生方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9891/\">中学校の先生方へ</a></li>\n              <li><a href=\"/visit_society/\">社会人・大学生・短大生の方へ</a></li>\n              <li><a href=\"/visit_company/\">企業の方へ<span class=\"inline-block\">（求人掲載はコチラ）</span></a></li>\n              <li><a href=\"/recruit/\">職員募集につきまして</a></li>\n              <li><a href=\"/visit_municipality/\">産官学連携にご協力いただける企業・自治体の方へ</a></li>\n            </ul>\n          </div>\n          <ul class=\"sp-menu-btns\">\n            <li><a href=\"/form/inquiry/\"><span class=\"icon mail\"><img src=\"/asset/img/share/icon-mail.png\" alt=\"\" width=\"39\" height=\"28\"></span>お問い合わせ</a></li>\n            <li><a href=\"/school/access/\"><span class=\"icon access\"><img src=\"/asset/img/share/icon-access.png\" alt=\"\" width=\"28\" height=\"36\"></span>アクセス</a></li>\n          </ul>\n          <ul class=\"sp-other-btns\">\n            <li><a href=\"/school/info/\">情報公開(職業実践専門課程)</a></li>\n            <li><a href=\"/news/2024/11771/\">施設(教室)利用貸出につきまして</a></li>\n            <li><a href=\"/privacy/\">プライバシーポリシー</a></li>\n            <li><a href=\"/recruit/\">採用情報</a></li>\n            <li><a href=\"/sitemap/\">サイトマップ</a></li>\n            <li><a href=\"/socialpolicy/\">ソーシャルメディアポリシー</a></li>\n          </ul>\n        </div>\n        <div class=\"sns-link-box\">\n          <div class=\"sns-item instagram\">\n            <a href=\"https://www.instagram.com/sapporo_kango/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-instagram.png\" alt=\"\" width=\"58\" height=\"58\">\n            </a>\n          </div>\n          <div class=\"sns-item tiktok\">\n            <a href=\"https://www.tiktok.com/@sapporo_kango\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-tiktok.png\" alt=\"\" width=\"41\" height=\"48\">\n            </a>\n          </div>\n          <div class=\"sns-item youtube\">\n            <a href=\"https://www.youtube.com/channel/UCQU3cRE2T7qim5OOqXSDjww\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-youtube.png\" alt=\"\" width=\"55\" height=\"39\">\n            </a>\n          </div>\n          <div class=\"sns-item line\">\n            <a href=\"https://lin.ee/kxlpB4B\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-line.png\" alt=\"\" width=\"56\" height=\"56\">\n            </a>\n          </div>\n        </div>\n      </div>\n    </header>\n      <div class=\"main admission scholarship\">\n        <div class=\"mv mv-block\">\n          <div class=\"wrap\">\n            <h1 class=\"page-ttl\">\n              <span class=\"text-wrap\">\n                <span class=\"eng\">ADMISSION</span>\n                <span class=\"ja\">特待生&amp;減免制度</span>\n              </span>\n            </h1>\n          </div>\n          <div class=\"bg-box\"><img src=\"/asset/img/admission/share/2025/mv.jpg\" alt=\"\" width=\"740\" height=\"330\"></div>\n        </div>\n                <div class=\"content-block no-lead\">\n          <div class=\"wrap\">\n                    \n            <div class=\"content-box\">\n              <div class=\"wrap-text\">\n                <h2 class=\"content-ttl01\">最大50万円減免！<br>自分の強みや学びの成果を活かせる<span class=\"inline-block\">特待生制度</span></h2>\n                <h3 class=\"content-ttl02\">特待生制度<span class=\"inline-block\">[AO入試（総合型選抜）・指定校推薦入試・高校（公募）推薦入試の方]</span><br><small>※希望者のみ</small></h3>\n                <p class=\"mb01\">AO入試（総合型選抜）・指定校推薦入試・高校（公募）推薦入試の方は、学費減免のチャンスがある特待生試験にチャレンジできます。</p>\n              </div>\n              <div class=\"content-inner\">\n                <table class=\"common-tbl\"><tbody>\n                  <tr>\n                    <th class=\"w25\"></th>\n                    <th>特待生制度<br>（AO入試・指定校推薦入試・高校（公募）推薦入試の方）</th>\n                  </tr>\n                  <tr>\n                    <th>対象者</th>\n                    <td>\n                      <p>本校にAO入試（総合型選抜）、指定校推薦入試、高校（公募）推薦入試で出願された方。</p>\n                    </td>\n                  </tr>\n                  <tr>\n                    <th rowspan=\"2\">試験内容<br><small>※どちらかを選択</small></th>\n                    <td>\n                      <p>実技特待：目指す職業に必要な知識や技術</p>\n                      <ul class=\"notes\">\n                        <li>具体的な内容は本校HP、オープンキャンパスにてご案内します。</li>\n                      </ul>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td>\n                      <p>筆記特待：国語（古文・漢文をのぞく）</p>\n                      <ul class=\"notes\">\n                        <li>看護学科は筆記特待のみとなります。</li>\n                      </ul>\n                    </td>\n                  </tr>\n                  <tr>\n                    <th>減免額</th>\n                    <td>\n                      <p>合格者は初年度学費より、下記の金額が減免されます。<span class=\"block\">第I種：500,000円　第II種：200,000円　<span class=\"inline-block\">第Ⅲ種：50,000円</span></span></p>\n                    </td>\n                  </tr>\n                  <tr>\n                    <th>合格定員</th>\n                    <td>募集定員の20％以内</td>\n                  </tr>\n                  <tr>\n                    <th>申込方法</th>\n                    <td>出願フォームの「実技特待」もしくは「筆記特待」に希望を入力する。</td>\n                  </tr>\n                  <tr>\n                    <th>結果通知</th>\n                    <td>\n                      <ul class=\"list-disc\">\n                        <li>入学試験日より2週間以内に、入学選考と特待生試験の結果を一緒にお送りします。</li>\n                        <li>特待生試験の結果が入学選考に影響することはありません。</li>\n                        <li>AO第1期で出願された方で調査書を後日提出される方は、調査書の確認ができ次第、結果をお送りします。</li>\n                      </ul>\n                    </td>\n                  </tr>\n                </tbody></table>\n              </div>\n              <div class=\"content-inner\">\n                <h4 class=\"content-ttl04\">特待生試験日</h4>\n                <table class=\"common-tbl admission-tbl\">\n                  <tbody>\n                    <tr>\n                      <th>特待生<span class=\"inline-block\">試験日</span></th>\n                      <td class=\"txt-center\">2026年<br>9/27<br>（日）</td>\n                      <td class=\"txt-center\">2026年<br>10/18<br>（日）</td>\n                      <td class=\"txt-center\">2026年<br>11/8<br>（日）</td>\n                      <td class=\"txt-center\">2026年<br>12/6<br>（日）</td>\n                      <td class=\"txt-center\">2027年<br>1/9<br>（土）</td>\n                    </tr>\n                    <tr>\n                      <th>ネット出願受付<span class=\"inline-block\">期間</span></th>\n                      <td class=\"txt-center\">9/1（火）～9/24（木）</td>\n                      <td class=\"txt-center\">9/28（月）～10/15（木）</td>\n                      <td class=\"txt-center\">10/19（月）～11/5（木）</td>\n                      <td class=\"txt-center\">11/9（月）～12/3（木）</td>\n                      <td class=\"txt-center\">12/7（月）～1/7（木）</td>\n                    </tr>\n                    <tr>\n                      <th>AO入試<span class=\"inline-block\">（総合型選抜）</span></th>\n                      <td class=\"txt-center\">第1期<br>◯</td>\n                      <td class=\"txt-center\">第2期<br>◯</td>\n                      <td class=\"txt-center\">第3期<br>◯</td>\n                      <td class=\"txt-center\">第4期<br>◯</td>\n                      <td class=\"txt-center\">第5期<br>◯</td>\n                    </tr>\n                    <tr>\n                      <th>指定校・<span class=\"inline-block\">高校</span><span class=\"inline-block\">（公募）</span>・<span class=\"inline-block\">業界推薦</span>入試</th>\n                      <td></td>\n                      <td class=\"txt-center\">10/1（木）〜<br>◯</td>\n                      <td></td>\n                      <td></td>\n                      <td></td>\n                    </tr>\n                    <tr>\n                      <th>特待生試験<span class=\"inline-block\">（希望者のみ）</span></th>\n                      <td class=\"txt-center\">第1期<br>◯</td>\n                      <td class=\"txt-center\">第2期<br>◯</td>\n                      <td class=\"txt-center\">第3期<br>◯</td>\n                      <td class=\"txt-center\">第4期<br>◯</td>\n                      <td class=\"txt-center\">第5期<br>◯</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n              <div class=\"content-inner\">\n                <h4 class=\"content-ttl04\">実技特待生対策講座</h4>\n                <ul class=\"notes mb01\">\n                  <li>実技特待を受験希望の方は受講必須です。</li>\n                </ul>\n                <table class=\"common-tbl\">\n                  <thead>\n                    <tr>\n                      <th colspan=\"2\">開催日</th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    <tr>\n                      <td class=\"w50\">①4/25（土）★</td>\n                      <td class=\"w50\">⑥9/12（土）</td>\n                    </tr>\n                    <tr>\n                      <td>②5/30（土）★</td>\n                      <td>⑦10/10（土）</td>\n                    </tr>\n                    <tr>\n                      <td>③6/20（土）</td>\n                      <td>⑧11/3（火・祝）</td>\n                    </tr>\n                    <tr>\n                      <td>④7/25（土）★</td>\n                      <td>⑨12/5（土）</td>\n                    </tr>\n                    <tr>\n                      <td>⑤8/22（土）</td>\n                      <td></td>\n                    </tr>\n                  </tbody>\n                </table>\n                <p class=\"note\"><small>★は道内各地より無料送迎バス運行日</small></p>\n              </div>\n              <div class=\"banner-section\">\n                <a href=\"https://www.snm.ac.jp/news/2026/17673/\" class=\"banner\"><img src=\"/asset/img/share/2025/banner-scholarship-wide.png\" width=\"670\" height=\"310\" alt=\"実技特待生試験 対策講座\"></a>\n              </div>\n            </div>\n            \n            <div class=\"content-box\">\n              <h3 class=\"content-ttl02\">兄弟姉妹・保護者減免制度</h3>\n              <table class=\"common-tbl\"><tbody>\n                <tr>\n                  <th class=\"w25\">減免額</th>\n                  <td>初年度学費より、100,000円減免</td>\n                </tr>\n                <tr>\n                  <th>対象学科</th>\n                  <td>全学科</td>\n                </tr>\n                <tr>\n                  <th>応募資格</th>\n                  <td>受験生本人の兄弟姉妹または保護者が滋慶学園グループ北海道7校を含む全国の滋慶学園グループ校に在籍中、または卒業している者</td>\n                </tr>\n                <tr>\n                  <th>申込方法</th>\n                  <td>ネット出願フォームの「兄弟姉妹・保護者減免制度欄」に必要事項（氏名、入学年・卒業年、学校・学科名）を入力してください。</td>\n                </tr>\n              </tbody></table>\n            </div>\n\n            <div class=\"content-box\" id=\"scholar-unit\">\n              <h3 class=\"content-ttl02\">単位減免制度</h3>\n              <p class=\"mb01\">本学園の定める科目との互換性を認定する制度です。なお、審議の結果、認定された単位の学費を減免します。</p>\n              <table class=\"common-tbl\"><tbody>\n                <tr>\n                  <th rowspan=\"2\" class=\"w-1/5\">減免額</th>\n                  <td>A. 大学・短大・専門学校等卒業（及び見込）者の場合</td>\n                  <td>B. 医療国家資格取得（及び見込）者の場合</td>\n                </tr>\n                <tr>\n                  <td>\n                    <p>単位認定により2年次学費より最大80,000円減免</p>\n                    <ul class=\"notes\"><li>本学園と大学・短大・専門学校等との単位互換を換算し、最大16単位を互換認定</li></ul>\n                  </td>\n                  <td>\n                    <p>単位認定により2年次学費より最大100,000円減免</p>\n                    <ul class=\"notes\"><li>医療国家資格の種類により基礎分野最大16単位、専門基礎分野最大10単位、合計（最大）20単位までを認定</li></ul>\n                  </td>\n                </tr>\n                <tr>\n                  <th>対象<span class=\"inline-block\">学科</span></th>\n                  <td colspan=\"2\">全学科</td>\n                </tr>\n                <tr>\n                  <th>応募<span class=\"inline-block\">資格</span></th>\n                  <td>大学・短大・専門学校等卒業（及び見込）者</td>\n                  <td>医療国家資格取得（及び見込）者</td>\n                </tr>\n                <tr>\n                  <th>申込<span class=\"inline-block\">方法</span></th>\n                  <td colspan=\"2\">\n                    <p>出願時、単位減免希望欄で申し込みを受付します。</p>\n                    <p>入学後、卒業が確認できる必要書類を学校に提出してください。</p>\n                    <ul class=\"notes\"><li>単位認定後、2年次授業料より減免されます。</li></ul>\n                  </td>\n                </tr>\n                <tr>\n                  <th>必要<span class=\"inline-block\">書類</span></th>\n                  <td>\n                    <ul class=\"list-disc\">\n                      <li>単位修得証明書</li>\n                    </ul>\n                  </td>\n                  <td>\n                    <ul class=\"list-disc\">\n                      <li>単位修得証明書</li>\n                      <li>医療国家資格を証明する免許証の写し（見込者は取得後に、提出してください）</li>\n                    </ul>\n                  </td>\n                </tr>\n              </tbody></table>\n            </div>\n\n            <div class=\"content-box\">\n              <h3 class=\"content-ttl02\">卒業生減免制度</h3>\n              <p class=\"mb01\">本学園卒業生を対象とした減免制度です。社会人のスキルアップを応援する制度となっています。</p>\n              <table class=\"common-tbl\"><tbody>\n                <tr>\n                  <th class=\"w25\">減免額</th>\n                  <td>初年度学費より、150,000円+入学金200,000円減免</td>\n                </tr>\n                <tr>\n                  <th>対象学科</th>\n                  <td>全学科</td>\n                </tr>\n                <tr>\n                  <th>応募資格</th>\n                  <td>\n                    <p>受験生本人が滋慶学園グループ北海道7校を含む全国の滋慶学園グループ校を卒業している者。</p>\n                    <ul class=\"notes\"><li>卒業年は問いません。</li></ul>\n                  </td>\n                </tr>\n                <tr>\n                  <th>申込方法</th>\n                  <td>\n                    <p>ネット出願フォームのチェック欄に必要事項（卒業年、学校・学科名）を入力してください。</p>\n                  </td>\n                </tr>\n                <tr>\n                  <th>必要書類</th>\n                  <td>卒業証明書のコピー</td>\n                </tr>\n              </tbody></table>\n            </div>\n                                    <div class=\"content-box\">\n              <div class=\"banner-section\">\n                <a href=\"/admission/expenses/\" class=\"banner\"><img src=\"/asset/img/admission/share/2025/bnr-tuition-support.png\" width=\"700\" height=\"324\" alt=\"\"></a>\n              </div>\n            </div>\n\n            <!-- <div class=\"content-box\">\n              <div class=\"content-inner\">\n                <h3 class=\"content-ttl02\">特待生試験対策講座（学科特待）</h3>\n                <ul class=\"notes\">\n                  <li>下記日程のオープンキャンパス内で、特待生試験（学科特待）の対策講座を実施します。</li>\n                  <li>筆記特待希望者には過去問題を配布します（郵送可）。</li>\n                </ul>\n              </div>\n              <div class=\"content-inner\">\n                <table class=\"common-tbl\">\n                  <thead>\n                    <tr>\n                      <th colspan=\"2\">開催日</th>\n                    </tr>\n                  </thead>\n                  <tbody>\n                    <tr>\n                      <td class=\"w50\">①4/28（日）</td>\n                      <td class=\"w50\">⑤8/17（土）</td>\n                    </tr>\n                    <tr>\n                      <td>②5/18（土）</td>\n                      <td>⑥9/14（土）★</td>\n                    </tr>\n                    <tr>\n                      <td>③6/15（土）</td>\n                      <td>⑦10/5（土）</td>\n                    </tr>\n                    <tr>\n                      <td>④7/28（日）</td>\n                      <td></td>\n                    </tr>\n                  </tbody>\n                </table>\n                <p class=\"note\"><small>★は道内各地より無料送迎バス運行日</small></p>\n              </div>              \n            </div> -->\n          </div>\n        </div>\n       \n      </div><!-- /.main -->\n      \n     <footer>\n        <div class=\"footer bg-white\">\n                    <div class=\"ft-bottom-block\">\n            <div class=\"ft-body\">\n              <div class=\"ft-body-wrap\">\n                <div class=\"ft-info-box\">\n                  <h1 class=\"ft-siteid\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"476\" height=\"80\"></a></h1>\n                  <p class=\"address\">〒004-0051<br><span class=\"inline-block\">札幌市厚別区厚別中央1条5丁目1番5号</span></p>\n                  <p class=\"tel\">TEL：011-801-8343（代表番号）<br>FAX：011-801-8345<br>フリーダイヤル：