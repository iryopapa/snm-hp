 "bodyHtml": "\n<!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-P994MCR\"\nheight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n<!-- End Google Tag Manager (noscript) -->\n\n<div id=\"ads-modal\" class=\"ads-modal-container\">\n  <div class=\"modal-content\">\n    <div class=\"close-button\"><img src=\"/asset/img/share/2026/button-ads-close.png\" loading=\"lazy\" alt=\"\" width=\"44\" height=\"44\"></div>\n        <a href=\"https://www.snm.ac.jp/news/2026/18962/\" class=\"banner ads-modal-banner\">\n      <img src=\"/asset/img/share/2026/banner-ads-oc01.jpg\" loading=\"lazy\" alt=\"オープンキャンパス\" width=\"295\" height=\"443\">\n    </a>\n      </div>\n</div><div class=\"contents-wrapper\">\n  <div class=\"contents-left\">\n    <div class=\"site-wrap\">\n  <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"238\" height=\"33\"></a></h1>\n  <p class=\"site-catch\"><img src=\"/asset/img/share/2025/site-catch.png\" alt=\"Future is yours\" width=\"310\" height=\"175\"></p>\n</div>      <div class=\"main-wrapper\">\n      \n    <header>\n      <input type=\"checkbox\" name=\"menu-switch\" id=\"menu-switch\" class=\"nav-checkbox\">\n      <div class=\"header\">\n        <h1 class=\"site-id\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"420\" height=\"58\"></a></h1>\n        <div class=\"nav-block\">\n          <label for=\"menu-switch\" class=\"menu-btn\">\n            <span class=\"btn-label\">\n              <span></span><span></span><span></span>\n            </span>\n          </label>\n        </div>\n      </div>\n      <div class=\"sp-menu\">\n        <div class=\"inner\">\n          <ul class=\"sp-cv-btns\">\n            <li class=\"sp-cv-oc\">\n              <a href=\"/opencampus/\" class=\"banner\">\n                <span class=\"label\">オープン<br>キャンパス</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img01.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n                        <li class=\"sp-cv-request\">\n              <a href=\"/form/document/\" target=\"_blank\" rel=\"noopener\" class=\"no-icon banner\">\n                <span class=\"label\">資料請求</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img03.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n            <li class=\"sp-cv-special\">\n              <a href=\"/special/\" class=\"banner\">\n                <span class=\"label\">お仕事<br>紹介</span>\n                <span class=\"bg\"><img src=\"/asset/img/share/2025/menu-img04.jpg\" alt=\"\" width=\"290\" height=\"130\"></span>\n              </a>\n            </li>\n          </ul>\n          <nav>\n            <ul class=\"sp-gnav\">\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav01\">\n                <label for=\"sp-nav01\" class=\"category-ttl\"><span class=\"en\">ABOUT</span>学校案内</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/school/\">学校案内 トップ</a></li>\n                  <li><a href=\"/school/study/\">札幌看護医療が選ばれる理由</a></li>\n                  <li><a href=\"/school/guide/\">高校1・2年生のための進路選び</a></li>\n                  <li><a href=\"/school/access/\">交通・アクセス</a></li>\n                  <li><a href=\"/school/philosophy/\">建学の理念</a></li>\n                  <li><a href=\"/school/info/\">情報公開（職業実践専門課程）</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav02\">\n                <label for=\"sp-nav02\" class=\"category-ttl\"><span class=\"en\">COURSE</span>学科・専攻</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/course/\">学科・専攻 トップ</a></li>\n                  <li><a href=\"/course/nursing/\">看護学科</a></li>\n                  <li><a href=\"/course/orthoptist/\">視能訓練士学科</a></li>\n                  <li><a href=\"/course/dentalhygienists/\">歯科衛生士学科<br>ホワイトニング・デンタルエステ専攻</a></li>\n                  <li><a href=\"/course/clinicalengineer/\">臨床工学技士学科</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav03\">\n                <label for=\"sp-nav03\" class=\"category-ttl\"><span class=\"en\">CARRER</span>資格・就職</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/career/\">資格・就職 トップ</a></li>\n                  <li><a href=\"/career/license_support/\">資格サポート</a></li>\n                  <li><a href=\"/career/job_result/\">就職サポート</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav04\">\n                <label for=\"sp-nav04\" class=\"category-ttl\"><span class=\"en\">CAMPUS LIFE</span>学校生活・施設</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/campuslife/\">学校生活・施設 トップ</a></li>\n                  <li><a href=\"/campuslife/schedule/\">キャンパスライフ</a></li>\n                  <li><a href=\"/campuslife/facility/\">施設紹介</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav05\">\n                <label for=\"sp-nav05\" class=\"category-ttl\"><span class=\"en\">ADMISSION</span>入試・学費</label>\n                <ul class=\"category-list txt-link\">\n                  <li><a href=\"/admission/\">入試・学費 トップ</a></li>\n                  <li><a href=\"/admission/application/\">募集要項・出願概要</a></li>\n                  <li><a href=\"/admission/ao/\">AO入試エントリー・AO入試出願方法</a></li>\n                  <li><a href=\"/admission/applicationflow/\">推薦・一般入試 出願方法</a></li>\n                  <li><a href=\"/admission/expenses/\">学費・奨学金制度</a></li>\n                  <li><a href=\"/admission/scholarship/\">特待生＆減免制度</a></li>\n                </ul>\n              </li>\n              <li>\n                <input type=\"checkbox\" name=\"sp-nav\" id=\"sp-nav06\">\n                <label for=\"sp-nav06\" class=\"category-ttl\"><span class=\"en\">OPEN CAMPUS</span>オープンキャンパス・説明会</label>\n                <ul class=\"category-list\">\n                  <li><a href=\"/opencampus/\">オープンキャンパスとは</a></li>\n                  <li><a href=\"/opencampus/calendar/\">イベント全日程一覧</a></li>\n                  <li><a href=\"/news/2026/17955/\">入試説明会</a></li>\n                  <li><a href=\"/opencampus/session/\">学校説明・個別相談会</a></li>\n                  <li><a href=\"/opencampus/bus/\">無料送迎バス</a></li>\n                  <li><a href=\"/opencampus/subsidy_list/\">交通費補助</a></li>\n                  <li><a href=\"/news/2026/18039/\">出張オープンキャンパス</a></li>\n                  <li><a href=\"/news/2021/5543/\">高校訪問ガイダンス</a></li>\n                </ul>\n              </li>\n                          </ul>\n          </nav>\n          <div class=\"sp-visitor-box\">\n            <input type=\"checkbox\" name=\"visitor-menu\" id=\"sp-visitor-menu\">\n            <label for=\"sp-visitor-menu\">\n              <span class=\"txt\">訪問者別メニュー</span>\n            </label>\n            <ul class=\"visitor-list\">\n              <li><a href=\"/visit_graduate/\">卒業生の方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9888/\">高等学校の先生方へ</a></li>\n              <li><a href=\"https://www.snm.ac.jp/news/2023/9891/\">中学校の先生方へ</a></li>\n              <li><a href=\"/visit_society/\">社会人・大学生・短大生の方へ</a></li>\n              <li><a href=\"/visit_company/\">企業の方へ<span class=\"inline-block\">（求人掲載はコチラ）</span></a></li>\n              <li><a href=\"/recruit/\">職員募集につきまして</a></li>\n              <li><a href=\"/visit_municipality/\">産官学連携にご協力いただける企業・自治体の方へ</a></li>\n            </ul>\n          </div>\n          <ul class=\"sp-menu-btns\">\n            <li><a href=\"/form/inquiry/\"><span class=\"icon mail\"><img src=\"/asset/img/share/icon-mail.png\" alt=\"\" width=\"39\" height=\"28\"></span>お問い合わせ</a></li>\n            <li><a href=\"/school/access/\"><span class=\"icon access\"><img src=\"/asset/img/share/icon-access.png\" alt=\"\" width=\"28\" height=\"36\"></span>アクセス</a></li>\n          </ul>\n          <ul class=\"sp-other-btns\">\n            <li><a href=\"/school/info/\">情報公開(職業実践専門課程)</a></li>\n            <li><a href=\"/news/2024/11771/\">施設(教室)利用貸出につきまして</a></li>\n            <li><a href=\"/privacy/\">プライバシーポリシー</a></li>\n            <li><a href=\"/recruit/\">採用情報</a></li>\n            <li><a href=\"/sitemap/\">サイトマップ</a></li>\n            <li><a href=\"/socialpolicy/\">ソーシャルメディアポリシー</a></li>\n          </ul>\n        </div>\n        <div class=\"sns-link-box\">\n          <div class=\"sns-item instagram\">\n            <a href=\"https://www.instagram.com/sapporo_kango/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-instagram.png\" alt=\"\" width=\"58\" height=\"58\">\n            </a>\n          </div>\n          <div class=\"sns-item tiktok\">\n            <a href=\"https://www.tiktok.com/@sapporo_kango\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-tiktok.png\" alt=\"\" width=\"41\" height=\"48\">\n            </a>\n          </div>\n          <div class=\"sns-item youtube\">\n            <a href=\"https://www.youtube.com/channel/UCQU3cRE2T7qim5OOqXSDjww\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-youtube.png\" alt=\"\" width=\"55\" height=\"39\">\n            </a>\n          </div>\n          <div class=\"sns-item line\">\n            <a href=\"https://lin.ee/kxlpB4B\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"no-icon\">\n              <img src=\"/asset/img/share/icon-line.png\" alt=\"\" width=\"56\" height=\"56\">\n            </a>\n          </div>\n        </div>\n      </div>\n    </header>\n      <div class=\"main career license_support\">\n        <div class=\"mv mv-block\">\n          <div class=\"wrap\">\n            <h2 class=\"page-ttl\">\n              <span class=\"text-wrap\">\n                <span class=\"eng\">CAREER</span>\n                <span class=\"ja\">資格サポート</span>\n              </span>\n            </h2>\n          </div>\n          <p class=\"mv-catch\"><img src=\"/asset/img/career/share/2025/mv-catch.png\" alt=\"私はここで、なりたいジブンへ。\" width=\"483\" height=\"250\"></p>\n          <div class=\"bg-box\"><img src=\"/asset/img/career/share/2026/mv.jpg\" alt=\"\" width=\"740\" height=\"330\"></div>\n        </div>\n        <div class=\"content-body\">\n          <div class=\"license-block bg-white\">\n            <div class=\"wrap\">\n              <h2 class=\"head-title\"><span class=\"bg\">札幌看護医療専門学校で</span><br><span class=\"bg mt\">取得できる豊富な資格！</span></h2>\n            </div>\n            <div class=\"license-wrap\">\n              <div class=\"wrap\">\n                <div class=\"license-group nursing\">\n                  <h3 class=\"license-title\"><span class=\"icon\"><img src=\"/asset/img/career/license_support/license-icon01.png\" alt=\"\" width=\"27\" height=\"19\"></span><span class=\"txt\">看護学科</span></h3>\n                  <ul class=\"dot-list\">\n                    <li>看護師（国家資格）</li>\n                    <li>保健師・助産師学校の受験資格</li>\n                    <li>養護教諭課程の受験資格</li>\n                    <li>看護大学の編入試験の受験資格</li>\n                  </ul>\n                </div>\n                <div class=\"license-group orthoptist\">\n                  <h3 class=\"license-title\"><span class=\"icon\"><img src=\"/asset/img/career/license_support/license-icon02.png\" alt=\"\" width=\"21\" height=\"22\"></span><span class=\"txt\">視能訓練士学科</span></h3>\n                  <ul class=\"dot-list\">\n                    <li>視能訓練士（国家資格）</li>\n                    <li>同行援護従業者養成研修一般課程</li>\n                    <li>同行援護従業者養成研修応用課程<span class=\"inline-block\">（選択）</span></li>\n                    <li>分部科学省後援　色彩検定<span class=\"inline-block\">（選択）</span></li>\n                  </ul>\n                </div>\n                <div class=\"license-group dentalhygienists\">\n                  <h3 class=\"license-title\"><span class=\"icon\"><img src=\"/asset/img/career/license_support/license-icon03.png\" alt=\"\" width=\"17\" height=\"29\"></span><span class=\"txt\">歯科衛生士学科</span></h3>\n                  <ul class=\"dot-list\">\n                    <li>歯科衛生士<span class=\"inline-block\">（国家資格）</span></li>\n                    <li>アロマテラピー検定1級<span class=\"inline-block\">（選択）</span></li>\n                  </ul>\n                </div>\n                <div class=\"license-group clinicalengineer\">\n                  <h3 class=\"license-title\"><span class=\"icon\"><img src=\"/asset/img/career/license_support/license-icon04.png\" alt=\"\" width=\"25\" height=\"20\"></span><span class=\"txt\">臨床工学技士学科</span></h3>\n                  <ul class=\"dot-list\">\n                    <li>臨床工学技士<span class=\"inline-block\">（国家資格）</span></li>\n                    <li>第1種ME技術実力検定試験<span class=\"inline-block\">（選択）</span></li>\n                    <li>第2種ME技術実力検定試験</li>\n                    <li>心電図検定<span class=\"inline-block\">（選択）</span></li>\n                    <li>医療機器情報コミュニケーションMIDC検定<span class=\"inline-block\">試験</span><span class=\"inline-block\">（選択）</span></li>\n                  </ul>\n                </div>\n                <ul class=\"note-list\">\n                  <li>※卒業時「専門士」の称号を付与</li>\n                  <li>※専修学校教員資格（国家資格取得後、実務経験5年積んだ者）</li>\n                </ul>\n              </div>\n            </div>\n          </div>\n          <div class=\"support-block\">\n            <div class=\"support-wrap bg-white\">\n              <div class=\"wrap\">\n                <h2 class=\"head-title\"><span class=\"bg\">勉強が苦手な人も安心！</span><br><span class=\"bg mt\">きめ細やかな国家試験サポート </span></h2>\n                <p>国家試験対策では、放課後の個別サポートや、基礎学力から総復習する特別授業など、一人ひとりの学力に合わせた手厚いサポートで合格へと導きます。</p>\n                <div class=\"support-row\">\n                  <div class=\"support-col w100\">\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/2026/support-img01.jpg?date=202505\" alt=\"\" width=\"700\" height=\"466\"></div>\n                    <h3 class=\"support-title\"><span class=\"marker\"><span class=\"fuchidori\">頼れる先生</span>がいるから安心して勉強できる</span></h3>\n                    <p>業界に精通した先生が、学生一人ひとりにしっかりと向き合います。勉強や就職の悩みなど、何でも相談できるのはもちろん、わからないことはわかるまでじっくり教えてくれるので安心です。</p>\n                  </div>\n                  <div class=\"support-col\">\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/2026/support-img02.jpg\" alt=\"\" width=\"330\" height=\"330\"></div>\n                    <h3 class=\"support-title\"><span class=\"marker\">高校の基礎学力から総復習する<span class=\"fuchidori\">特別対策授業</span></span></h3>\n                    <p>高校での基礎が不安な人には、専門的な授業を受ける前に、特別対策授業で基礎を復習できるので安心です。</p>\n                  </div>\n                  <div class=\"support-col\">\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/2026/support-img03.jpg\" alt=\"\" width=\"330\" height=\"330\"></div>\n                    <h3 class=\"support-title\"><span class=\"marker\">放課後も<span class=\"fuchidori\">個別に学べる環境</span>で徹底的に知識を吸収</span></h3>\n                    <p>放課後も頼れる先生がわかるまで個別にサポート。また、図書館やカフェなどを使用しテストや国家試験前などに集中して勉強ができます。</p>\n                  </div>\n                  <div class=\"support-col\">\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/2026/support-img04.jpg\" alt=\"\" width=\"330\" height=\"330\"></div>\n                    <h3 class=\"support-title\"><span class=\"marker\">スマホでも試験勉強が可能な<span class=\"fuchidori\">e-Learning</span></span></h3>\n                    <p>自宅のパソコンやスマートフォンなどを使って勉強ができるシステムを確立。アプリ感覚で検定試験や国家試験の模擬試験にいつでもチャレンジできます。</p>\n                  </div>\n                  <div class=\"support-col\">\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/support-img05.jpg\" alt=\"\" width=\"330\" height=\"330\"></div>\n                    <h3 class=\"support-title\"><span class=\"marker\">試験の傾向に合わせた<span class=\"fuchidori\">オリジナル教材</span>を活用</span></h3>\n                    <p>滋慶学園グループの卒業生5万人のデータを分析し、資格試験の傾向にあわせたオリジナルの問題集や模擬試験を制作。国家資格の合格に直結した学びを実践しています。</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div class=\"result-support bg-white reverse\">\n              <div class=\"wrap\">\n                <p class=\"sub-title\">\n                  <span class=\"inner\"><span class=\"marker\"><span class=\"dot\">手</span><span class=\"dot\">厚</span><span class=\"dot\">い</span><span class=\"dot\">サ</span><span class=\"dot\">ポ</span><span class=\"dot\">ー</span><span class=\"dot\">ト</span>で国家試験に挑戦！</span></span>\n                </p>\n                <ul class=\"support-list\">\n                  <li>\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/2025/result-support01.png\" alt=\"\" width=\"100\" height=\"68\"></div>\n                    <p>経験豊かな<br>先生による<br>試験対策授業</p>\n                  </li>\n                  <li>\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/2025/result-support02.png\" alt=\"\" width=\"100\" height=\"68\"></div>\n                    <p>いつでもどこでも<br>試験勉強が可能な<br>e-Learning</p>\n                  </li>\n                  <li>\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/2025/result-support03.png\" alt=\"\" width=\"100\" height=\"68\"></div>\n                    <p>放課後も<br>個別に学べる<br>学習環境</p>\n                  </li>\n                  <li>\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/2025/result-support04.png\" alt=\"\" width=\"100\" height=\"68\"></div>\n                    <p>試験の傾向に<br>合わせた<br>オリジナル教材</p>\n                  </li>\n                  <li>\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/2025/result-support05.png\" alt=\"\" width=\"100\" height=\"68\"></div>\n                    <p>過去問題を<br>活用した<br>オリジナル模擬試験</p>\n                  </li>\n                  <li>\n                    <div class=\"img-box\"><img src=\"/asset/img/career/license_support/2025/result-support06.png\" alt=\"\" width=\"100\" height=\"68\"></div>\n                    <p>高校からの<br>基礎力を総復習する<br>特別授業</p>\n                  </li>\n                </ul>\n                <p class=\"txt anim fadeInUp\">\n                  <span class=\"inner\">\n                    <span class=\"deco\"><img src=\"/asset/img/career/license_support/result-deco.png\" alt=\"\" width=\"26\" height=\"36\"></span>合格！<span class=\"deco\"><img src=\"/asset/img/career/license_support/result-deco.png\" alt=\"\" width=\"26\" height=\"36\"></span>\n                  </span>\n                </p>\n                <div class=\"add-box\">\n                  <p class=\"title\">卒業後も無償サポート</p>\n                  <p>本校では、万が一不合格となった学生も卒業後サポートを継続し合格へ導きます。</p>\n                </div>\n              </div>\n            </div>            \n          </div>\n          <div class=\"content-bg\"><img src=\"/asset/img/share/2025/content-bg.jpg\" loading=\"lazy\" alt=\"\" width=\"780\" height=\"1230\"></div>\n                  </div>\n     \n      </div><!-- /.main -->\n      \n     <footer>\n        <div class=\"footer bg-white\">\n                    <div class=\"ft-bottom-block\">\n            <div class=\"ft-body\">\n              <div class=\"ft-body-wrap\">\n                <div class=\"ft-info-box\">\n                  <h1 class=\"ft-siteid\"><a href=\"/\"><img src=\"/asset/img/share/logo.png\" alt=\"札幌看護医療専門学校\" width=\"476\" height=\"80\"></a></h1>\n           