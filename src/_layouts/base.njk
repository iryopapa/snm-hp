<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive">
<title>{% if title %}{{ title }}｜{{ site.name }}{% else %}{{ site.name }}｜{{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ description or site.tagline }}">
<link rel="icon" href="/asset/img/share/logo.png">
{% if preloadImage %}<link rel="preload" as="image" href="{{ preloadImage }}" fetchpriority="high">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Hanken+Grotesk:wght@400;600;700;800&display=swap">
<link rel="stylesheet" href="/asset/css/vendor/swiper-bundle.min.css">
<link rel="stylesheet" href="/asset/css/tokens.css">
<link rel="stylesheet" href="/asset/css/base.css">
<link rel="stylesheet" href="/asset/css/components.css">
<link rel="stylesheet" href="/asset/css/motion.css">
{% if pageCss %}<link rel="stylesheet" href="{{ pageCss }}">{% endif %}
<script>document.documentElement.classList.add("js");window.SITE_BASE="{{ '/' | htmlBaseUrl }}";</script>
</head>
<body class="{{ bodyClass }}">
<div class="l-stage">
  {% include "rail-left.njk" %}
  <div class="l-column">
    {% include "header.njk" %}
    <main class="l-main" id="main">{{ content | safe }}</main>
    {% include "footer.njk" %}
    {% include "fixed-cta.njk" %}
  </div>
  {% include "rail-right.njk" %}
</div>
<script defer src="/asset/js/vendor/gsap.min.js"></script>
<script defer src="/asset/js/vendor/ScrollTrigger.min.js"></script>
<script defer src="/asset/js/vendor/swiper-bundle.min.js"></script>
<script defer src="/asset/js/main.js"></script>
<script defer src="/asset/js/motion/reveal.js"></script>
<script defer src="/asset/js/motion/counter.js"></script>
<script defer src="/asset/js/motion/hero.js"></script>
<script defer src="/asset/js/motion/sparkle.js"></script>
<script type="speculationrules">{"prerender":[{"where":{"href_matches":"{{ '/' | htmlBaseUrl }}*"},"eagerness":"moderate"}]}</script>
{% if pageJs %}<script defer src="{{ pageJs }}"></script>{% endif %}
</body>
</html>
