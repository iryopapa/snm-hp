      </div>
      <figure class="p-special__qa-img" data-anim="fade"><img src="/asset/img/special/dentalhygienists/2025/interview-img02.jpg" alt="" width="608" height="421" loading="lazy"></figure>
      <div class="p-special__qa-group" data-anim="fade-up">
