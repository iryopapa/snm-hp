{#- 8. STEP UPゼミ -#}
<section class="p-course__section p-course__seminar u-section">
  <p class="p-course__training-topimg" data-anim="fade-up"><img src="/asset/img/course/orthoptist/2026/seminar-top-img01.webp" loading="lazy" alt="" width="672" height="300"></p>
  <h3 class="p-course__block-title" data-anim="fade-up">
    <span class="en">YOUR CHOICES</span>
    <span class="catch">[ 選べる！ ]</span>
    <span class="ttl">STEP UPゼミで<br>資格＋αの学び</span>
  </h3>
  <p class="u-center" data-anim="fade-up">自分の「学びたい」に合わせてゼミを選択♪<br>＋αの力を身につけた視能訓練士を目指そう！</p>
  {%- set seminars1 = [
    {id: "seminar01-01", icon: "seminar01-img01.png", name: "OCTゼミ", modal: "OCTゼミ", imgs: [{f: "seminar01-modal01-img01.webp", w: 592, h: 396}, {f: "seminar01-modal01-img02.webp", w: 593, h: 247}], txt: "医療機器メーカーの方や現場で活躍している視能訓練士の方を招き、さまざまな知識を学びます。主に3次元眼底カメラ（網膜断層画像を撮る最新の機器）を用いてデータを収集し、研究発表にもチャレンジします。"},
    {id: "seminar01-02", icon: "seminar01-img02.png", name: "眼鏡ゼミ", modal: "眼鏡ゼミ", imgs: [{f: "seminar01-modal02-img01.webp", w: 592, h: 396}, {f: "seminar01-modal02-img02.webp", w: 593, h: 247}], txt: "「最適なメガネを完成させよう！」をテーマに視力矯正、レンズ装用テストを経て、眼鏡店でのレンズやフレーム選び、レンズ加工も視察することで「メガネの完成」までを学びながら体験していきます。"},
    {id: "seminar01-03", icon: "seminar01-img03.png", name: "同行援護ゼミ", modal: "同行援護ゼミ", imgs: [{f: "seminar01-modal03-img01.webp", w: 592, h: 396}, {f: "seminar01-modal03-img02.webp", w: 629, h: 373}], txt: "患者さんにとって、安心・安全な援護をできる応用の資格（応用課程）を取得。視覚障がい者の方の介助や誘導で、実際に地下鉄の乗降の練習やお買い物をしたり、水族館などに一緒に出かけて援護のコツをつかみます。"},
    {id: "seminar01-04", icon: "seminar01-img04.png", name: "コンタクトレンズ<br>ゼミ", modal: "コンタクトレンズゼミ", imgs: [{f: "seminar01-modal04-img01.webp", w: 592, h: 468}, {f: "seminar01-modal04-img02.webp", w: 593, h: 247}], txt: "様々なメーカーのコンタクトレンズの種類・特徴の知識を得ます。患者さんへの正しい装用指導を目指し、実際にコンタクトレンズを合わせます。また、専門店舗へ見学にも行き理解を深めていきます。"},
    {id: "seminar01-05", icon: "seminar01-img05.png", name: "手話ゼミ", modal: "手話ゼミ", imgs: [{f: "seminar01-modal05-img01.webp", w: 592, h: 396}, {f: "seminar01-modal05-img02.webp", w: 478, h: 269}], txt: "聴覚障がい者の方の安心につながる手話を基礎から学びます。座学だけでなく日常会話や表現力の向上に重点を置きます。"}
  ] -%}
  {%- set seminars2 = [
    {id: "seminar02-01", icon: "seminar02-img01.png", name: "札幌学院大学<br>心理ゼミ", modal: "札幌学院大学心理ゼミ", imgs: [{f: "seminar02-modal01-img01.webp", w: 592, h: 396}, {f: "seminar02-modal01-img02.webp", w: 593, h: 247}], txt: "札幌学院大学心理学部の教授から、医療現場で役立つコミュニケーションのほかアンガーマネジメントや恋愛心理などを学びます。アートセラピー体験（泥だんごやお絵描きなど）をしながらストレス解消法なども学べます。"},
    {id: "seminar02-02", icon: "seminar02-img02.png", name: "色彩ゼミ", modal: "色彩ゼミ", imgs: [{f: "seminar02-modal02-img01.webp", w: 592, h: 396}, {f: "seminar02-modal02-img02.webp", w: 593, h: 247}], txt: "色覚検査の枠を出て、ユニバーサルカラーや色使いに関する知識を深めます。また、自分に似合う色や好きな色など、色と環境を学びます。"},
    {id: "seminar02-03", icon: "seminar02-img03.png", name: "ヨガ・<br>ピラティスゼミ", modal: "ヨガ・ピラティスゼミ", imgs: [{f: "seminar02-modal03-img01.webp", w: 592, h: 396}, {f: "seminar02-modal03-img02.webp", w: 593, h: 247}], txt: "体の巡りを整えて、内側から美しさを引き出すピラティスを体験します。自宅で実践できるセルフケアの方法も指導。リラックス効果もあり、心身の健康維持に役立ちます。"},
    {id: "seminar02-04", icon: "seminar02-img04.png", name: "アロマ・<br>ヘアメイクゼミ", modal: "アロマ・ヘアメイクゼミ", imgs: [{f: "seminar02-modal04-img01.webp", w: 592, h: 396}, {f: "seminar02-modal04-img02.webp", w: 593, h: 247}], txt: "美しさを引き出すヘアメイク技術や心身を整えるアロマテラピーの知識を修得して、外見と内面から輝くトータルビューティーを目指します。"}
  ] -%}
  <div class="p-course__seminar-group" data-anim="fade-up">
    <p class="label">スキルアップ</p>
    <h4 class="title">前期ゼミ</h4>
    <p class="balloon"><img src="/asset/img/course/orthoptist/2026/seminar-balloon.png" loading="lazy" alt="気になるゼミをTAP!" width="95" height="51"></p>
    <ul class="p-course__seminar-list" data-anim-group>
      {%- for s in seminars1 %}
      <li data-anim="zoom"><button type="button" data-modal-open="{{ s.id }}"><span class="img"><img src="/asset/img/course/orthoptist/2026/{{ s.icon }}" loading="lazy" alt="" width="82" height="82"></span><span class="name">{{ s.name | safe }}</span></button></li>
      {%- endfor %}
    </ul>
  </div>
  <div class="p-course__seminar-group" data-anim="fade-up">
    <p class="label">自分磨き</p>
    <h4 class="title">後期ゼミ</h4>
    <ul class="p-course__seminar-list" data-anim-group>
      {%- for s in seminars2 %}
      <li data-anim="zoom"><button type="button" data-modal-open="{{ s.id }}"><span class="img"><img src="/asset/img/course/orthoptist/2026/{{ s.icon }}" loading="lazy" alt="" width="82" height="82"></span><span class="name">{{ s.name | safe }}</span></button></li>
      {%- endfor %}
    </ul>
  </div>
  {%- for s in seminars1.concat(seminars2) %}
  <dialog class="p-course__modal" id="{{ s.id }}">
    <p class="p-course__modal-title">{{ s.modal }}</p>
    <div class="p-course__modal-imgs">
      {%- for im in s.imgs %}
      <img src="/asset/img/course/orthoptist/2026/{{ im.f }}" alt="" loading="lazy" width="{{ im.w }}" height="{{ im.h }}">
      {%- endfor %}
    </div>
    <p>{{ s.txt }}</p>
  </dialog>
  {%- endfor %}
</section>

