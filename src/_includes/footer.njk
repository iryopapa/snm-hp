<footer class="c-footer">
  <div class="c-footer__inner">
    <a class="c-footer__logo" href="/">
      <img src="/asset/img/share/logo.png" alt="{{ site.name }}" width="238" height="33" loading="lazy">
    </a>
    <p class="c-footer__address">{{ site.address }}<br>TEL <a href="tel:{{ site.tel }}">{{ site.tel }}</a>／フリーダイヤル <a href="tel:{{ site.freedial }}">{{ site.freedial }}</a></p>

    <details class="c-footer__visitors">
      <summary>訪問者別メニュー</summary>
      <ul>
        {% for v in visitors %}
        <li><a href="{{ v.path }}"{% if v.external %} target="_blank" rel="noopener"{% endif %}>{{ v.label }}</a></li>
        {% endfor %}
      </ul>
    </details>

    <ul class="c-footer__sns">
      <li><a href="{{ site.sns.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><img src="/asset/img/share/icon-instagram.png" alt="Instagram" width="44" height="44" loading="lazy"></a></li>
      <li><a href="{{ site.sns.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><img src="/asset/img/share/icon-tiktok.png" alt="TikTok" width="44" height="44" loading="lazy"></a></li>
      <li><a href="{{ site.sns.youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><img src="/asset/img/share/icon-youtube.png" alt="YouTube" width="44" height="44" loading="lazy"></a></li>
      <li><a href="{{ site.sns.line }}" target="_blank" rel="noopener" aria-label="LINE"><img src="/asset/img/share/icon-line.png" alt="LINE" width="44" height="44" loading="lazy"></a></li>
    </ul>

    <ul class="c-footer__links">
      <li><a href="https://www.snm.ac.jp/form/inquiry/" target="_blank" rel="noopener">お問い合わせ</a></li>
      <li><a href="/school/access/">交通・アクセス</a></li>
      <li><a href="/school/info/">情報公開（職業実践専門課程）</a></li>
      <li><a href="/form/facility/">施設(教室)利用貸出につきまして</a></li>
      <li><a href="/recruit/">採用情報</a></li>
      <li><a href="/sitemap/">サイトマップ</a></li>
      <li><a href="/privacy/">プライバシーポリシー</a></li>
      <li><a href="/socialpolicy/">ソーシャルメディアポリシー</a></li>
    </ul>
  </div>
  <p class="c-footer__copyright"><small>&copy; 2025 Sapporo College of Nursing and Medical Health.</small></p>
  <a class="c-footer__pagetop" href="#" aria-label="ページ上部へ戻る">PAGE TOP</a>
</footer>
