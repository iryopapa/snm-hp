        <p class="number">STEP<span class="large">{{ s.no }}</span></p>
        <img src="/asset/img/opencampus/top/2026/{{ s.img }}" loading="lazy" alt="" width="280" height="260">
        <p class="time"><span class="icon"><img src="/asset/img/opencampus/top/2026/{{ s.icon }}" loading="lazy" alt="" width="30" height="30"></span>{{ s.time }}</p>
      </div>
      <div class="p-opencampus__step-txt">
        <h3>{{ s.ttl }}</h3>
        <p>{{ s.txt }}</p>
      </div>
    </li>
    {%- endfor %}
