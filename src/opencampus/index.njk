  {%- set steps = [
    {no: "01", time: "12：00〜", icon: "schedule-time01.png", img: "schedule-img01.jpg", ttl: "在校生と校舎⾒学！", txt: "在校生と一緒にキレイな校舎を見学♪教室の設備や当日のプログラムを紹介します。"},
    {no: "02", time: "12：20〜", icon: "schedule-time02.png", img: "schedule-img02.jpg", ttl: "プログラムをセレクト", txt: "アプリで参加したいプログラムをセレクト。自分の進路や「知りたい」に合わせて選んでね！"},
    {no: "03", time: "12：40〜", icon: "schedule-time03.png", img: "schedule-img03.jpg", ttl: "選んだ会場へGO！", txt: "MY時間割が完成したら、時間に合わせて会場へ！途中でプログラム変更もOK★"},
    {no: "04", time: "14：40〜", icon: "schedule-time04.png", img: "schedule-img04.jpg", ttl: "1日の振り返り", txt: "終了後は1日の振り返り♪未体験プログラムはまだまだたくさん。次回は別の時間割で参加してみよう！"}
