{#- プログラムの選び方 -#}
<section class="p-opencampus__select u-section" id="select">
  <div class="c-section-head" data-anim="fade-up">
    <span class="c-badge"><span class="c-badge__label">How to</span></span>
    <h2 class="c-section-head__catch">プログラムの選び方</h2>
  </div>
  <p class="p-opencampus__select-lead" data-anim="fade-up">自分の「好き」「知りたい」を自由にセレクトできるから、選び方は無限大！自分の夢や目標にまっすぐなプログラムを組もう！</p>
  {%- set cases = [
    {no: "1", ttlHtml: "<span class='large'>医療系進学</span>に悩むAさんの場合", select: "いろんなお仕事の話を聞いて体験できる", selectAfter: "プログラムをセレクト！", caseImg: "select01-img05.webp",
     items: [
       {time: "13:00", icon: "icon-clock01.png", txt: "医療のお仕事全部紹介",       img: "select01-img01.jpg"},
       {time: "13:30", icon: "icon-clock02.png", txt: "視能訓練士のお仕事体験",     img: "select01-img02.jpg"},
       {time: "14:00", icon: "icon-clock03.png", txt: "臨床工学技士のお仕事体験",   img: "select01-img03.jpg"},
       {time: "14:30", icon: "icon-clock04.png", txt: "歯科衛生士のお仕事体験",     img: "select01-img04.jpg"}
     ]},
    {no: "2", ttlHtml: "<span class='large'>入試や学校の雰囲気が</span><br><span class='large'>知りたい</span>Bさんの場合", select: "しっかりといろんな説明を聞いて", selectAfter: "入試に備えるプログラムをセレクト！", caseImg: "select02-img05.webp",
     items: [
       {time: "13:00", icon: "icon-clock01.png", txt: "学校・入試説明",                     img: "select02-img01.jpg"},
       {time: "13:30", icon: "icon-clock02.png", txt: "看護学科の学生とトーク",             img: "select02-img02.jpg"},
       {time: "14:00", icon: "icon-clock03.png", txt: "看護学科紹介",                       img: "select02-img03.jpg"},
       {time: "14:30", icon: "icon-clock04.png", txt: "進路・学費・1人暮らしなんでも相談", img: "select02-img04.jpg"}
     ]}
  ] -%}
  {%- for c in cases %}
  <div class="p-opencampus__case" data-anim="fade-up">
    <div class="p-opencampus__case-head">
      <p class="case-number">CASE<span class="num">{{ c.no }}</span></p>
      <p class="title">{{ c.ttlHtml | safe }}</p>
    </div>
    <p class="p-opencampus__case-select"><span class="u-marker" data-marker>{{ c.select }}</span><br>{{ c.selectAfter }}</p>
    <ol class="p-opencampus__case-list">
      {%- for i in c.items %}
      <li>
        <p class="time"><span class="icon"><img src="/asset/img/opencampus/top/2026/{{ i.icon }}" loading="lazy" alt="" width="14" height="14"></span>{{ i.time }}</p>
        <p class="txt">{{ i.txt }}</p>
        <p class="ph"><img src="/asset/img/opencampus/top/2026/{{ i.img }}" loading="lazy" alt="" width="240" height="170"></p>
      </li>
      {%- endfor %}
    </ol>
    <p class="p-opencampus__case-img"><img src="/asset/img/opencampus/top/2026/{{ c.caseImg }}" loading="lazy" alt="" width="285" height="45"></p>
  </div>
