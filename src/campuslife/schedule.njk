{%- for ev in events %}
<section class="p-campuslife__event{% if ev.reverse %} is-reverse{% endif %}">
  <div class="p-campuslife__event-head">
    <h3 class="ttl" data-anim="fade-up"><img src="{{ base }}{{ ev.title }}" loading="lazy" alt="{{ ev.alt }}" width="{{ ev.tw }}" height="{{ ev.th }}"></h3>
    <div class="deco" data-anim="stamp"><img src="{{ base }}{{ ev.deco }}" loading="lazy" alt="" width="{{ ev.dw }}" height="{{ ev.dh }}"></div>
  </div>
  <div class="p-campuslife__event-grid" data-anim-group>
    {%- for item in ev.items %}
    {%- set h = 519 if item.tall else 260 %}
    {%- if item.movie %}
    <a href="{{ item.movie }}" target="_blank" rel="noopener" class="p-campuslife__event-item is-movie{% if item.tall %} is-tall{% endif %}" data-anim="zoom">
      <img src="{{ base }}{{ item.p[0] }}" loading="lazy" alt="" width="260" height="{{ h }}">
      <span class="play">
        <span class="front"><img src="/asset/img/share/icon-play-front.png" loading="lazy" alt="" width="130" height="130"></span>
        <span class="text"><img src="/asset/img/share/icon-play-text.png" loading="lazy" alt="PLAY MOVIE" width="130" height="130"></span>
      </span>
    </a>
    {%- else %}
    <div class="p-campuslife__event-item{% if item.tall %} is-tall{% endif %}{% if item.p | length > 1 %} is-xfade" data-xfade{% else %}"{% endif %} data-anim="zoom">
      {%- for src in item.p %}
      <img src="{{ base }}{{ src }}" loading="lazy" alt="" width="260" height="{{ h }}"{% if not loop.first %} class="is-hidden"{% endif %}>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- endfor %}
  </div>
</section>
{%- endfor %}
