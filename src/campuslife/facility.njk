{#- 最新設備が揃った学びの空間 -#}
<section class="p-campuslife__fa-learning u-section">
  <h3 class="p-campuslife__fa-learning-title" data-anim="fade-up"><span class="u-marker" data-marker>最新設備が揃った学びの空間</span></h3>
  {%- set rooms = [
    {stop: "nursing-room", name: "看護実習室", txt: "実際の病院と同様の設備環境を備えた実習室。安全・安楽な援助を提供するための看護技術を身につけます。",
     imgs: ["learning01-img01.jpg"]},
    {stop: "maternity-room", name: "母性・小児在宅看護実習室", txt: "保育器や小児用ベッド、沐浴槽を備え、主に母性看護・小児看護の演習を行います。また実際の住居に近い環境で、近年需要の増えている在宅でのケアを学ぶことができる環境も整っています。",
     imgs: ["learning02-img01.jpg", "learning02-img02.jpg", "learning02-img03.jpg"]},
    {stop: "orthoptics-room", name: "視能実習室", txt: "電子視力表や検査機器を使用し、最新の眼科医療を学ぶことができます。",
     imgs: ["learning03-img01.jpg", "learning03-img02.jpg"]},
    {stop: "orthoptics-darkroom", name: "視能実習室（暗室）", txt: "最新の眼科医療機器や道内養成校初の3D眼底カメラを備え、現場で必要な実践力を身につけます。",
     imgs: ["learning04-img01.jpg"]},
    {stop: "dental-unit-room", name: "歯科ユニット実習室", txt: "最新のデジタルユニットを備えた実習室。ルーペやデジタルツールを使った最先端の技術を修得します。",
     imgs: ["learning05-img01.jpg"]},
    {stop: "dental-phantom-room", name: "歯科ファントム実習室", txt: "一人一台の専用マネキンとモニターを使って基礎実習を行います。",
     imgs: ["learning06-img01.jpg", "learning06-img02.jpg"]},
    {stop: "clinical-engineering-room", name: "臨床工学実習室", txt: "人工透析機器、人工心肺装置など病院で使われる最新の医療機器を備え、体験型実習で様々な現場に対応できる技術と知識を学びます。",
     imgs: ["learning07-img01.jpg", "learning07-img02.jpg"]},
    {stop: "basic-engineering-room", name: "基礎工学実習室", txt: "医療機器の原理・構造を学習するために電気・電子工学の実習を行い、必要となってくる装置の基本を学びます。",
     imgs: ["learning08-img01.jpg"]}
  ] -%}
  {%- for room in rooms %}
  <div class="p-campuslife__fa-room{% if loop.index is even %} is-reverse{% endif %}" data-tour-stop="{{ room.stop }}">
    {%- if room.imgs | length > 1 %}
    <div class="swiper js-facility-slide" data-anim="fade">
      <div class="swiper-wrapper">
        {%- for img in room.imgs %}
        <div class="swiper-slide"><img src="/asset/img/campuslife/facility/{{ img }}" loading="lazy" alt="" width="700" height="466"></div>
        {%- endfor %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
    {%- else %}
    <div class="img" data-anim="fade"><img src="/asset/img/campuslife/facility/{{ room.imgs[0] }}" loading="lazy" alt="" width="700" height="466"></div>
    {%- endif %}
    <div class="body" data-anim="fade-up">
      <p class="ttl">{{ room.name }}</p>
      <p class="txt">{{ room.txt }}</p>
    </div>
  </div>
  {%- endfor %}
</section>
