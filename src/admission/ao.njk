  <div class="p-admission__block" data-anim="fade-up">
    <a href="https://www.snm.ac.jp/news/2023/914/" target="_blank" rel="noopener" class="p-admission__banner-wide"><img src="/asset/img/share/2026/banner-line.jpg" width="700" height="324" alt="LINE何でも相談室 1対1トークで気軽に相談！" loading="lazy"></a>
